[{"start": 0.0, "end": 4.28, "text": "вы как бы видите шанс, просто провожаете его взглядом и ничего не делаете.", "words": [[0.0, 0.5, " вы"], [0.5, 0.68, " как"], [0.68, 0.86, " бы"], [0.86, 1.16, " видите"], [1.16, 1.68, " шанс,"], [1.9, 2.14, " просто"], [2.14, 2.62, " провожаете"], [2.62, 2.8, " его"], [2.8, 3.28, " взглядом"], [3.28, 3.36, " и"], [3.36, 3.6, " ничего"], [3.6, 3.84, " не"], [3.84, 4.28, " делаете."]]}, {"start": 4.6, "end": 8.5, "text": "Миллион рублей на счету с лихвой закрывает вот эту вашу готовность в этой формуле.", "words": [[4.6, 4.8, " Миллион"], [4.8, 5.04, " рублей"], [5.04, 5.2, " на"], [5.2, 5.5, " счету"], [5.5, 5.66, " с"], [5.66, 5.94, " лихвой"], [5.94, 6.46, " закрывает"], [6.46, 6.64, " вот"], [6.64, 6.78, " эту"], [6.78, 7.1, " вашу"], [7.1, 7.7, " готовность"], [7.7, 7.9, " в"], [7.9, 8.02, " этой"], [8.02, 8.5, " формуле."]]}, {"start": 8.86, "end": 13.24, "text": "Это деньги, которые позволяют вам сказать «да» новому проекту и не переживать по", "words": [[8.86, 8.98, " Это"], [8.98, 9.22, " деньги,"], [9.38, 9.52, " которые"], [9.52, 9.9, " позволяют"], [9.9, 10.26, " вам"], [10.26, 10.66, " сказать"], [10.66, 11.26, " «да»"], [11.26, 11.58, " новому"], [11.58, 12.26, " проекту"], [12.26, 12.54, " и"], [12.54, 12.74, " не"], [12.74, 13.06, " переживать"], [13.06, 13.24, " по"]]}, {"start": 13.24, "end": 18.16, "text": "поводу того, а что я буду кушать в следующем месяце, если, допустим, проект не выстрелит.", "words": [[13.24, 13.8, " поводу"], [13.8, 14.08, " того,"], [14.42, 14.54, " а"], [14.54, 14.62, " что"], [14.62, 14.74, " я"], [14.74, 14.92, " буду"], [14.92, 15.2, " кушать"], [15.2, 15.38, " в"], [15.38, 15.68, " следующем"], [15.68, 16.36, " месяце,"], [16.54, 16.76, " если,"], [16.76, 17.12, " допустим,"], [17.22, 17.42, " проект"], [17.42, 17.66, " не"], [17.66, 18.16, " выстрелит."]]}, {"start": 18.28, "end": 23.48, "text": "Если коротко, миллион дает вам самое дорогое на старте — это право на попробовать и право", "words": [[18.28, 18.58, " Если"], [18.58, 19.08, " коротко,"], [19.24, 19.42, " миллион"], [19.42, 19.62, " дает"], [19.62, 19.88, " вам"], [19.88, 20.14, " самое"], [20.14, 20.48, " дорогое"], [20.48, 20.7, " на"], [20.7, 21.16, " старте"], [21.16, 21.48, " —"], [21.48, 21.62, " это"], [21.62, 21.94, " право"], [21.94, 22.06, " на"], [22.06, 22.74, " попробовать"], [22.74, 23.04, " и"], [23.04, 23.48, " право"]]}, {"start": 23.48, "end": 29.98, "text": "на ошибиться. А ошибаться вы будете много. Если в предыдущем пункте мы говорили о миллионе", "words": [[23.48, 23.64, " на"], [23.64, 24.24, " ошибиться."], [24.64, 24.84, " А"], [24.84, 25.2, " ошибаться"], [25.2, 25.36, " вы"], [25.36, 25.58, " будете"], [25.58, 25.96, " много."], [27.08, 27.58, " Если"], [27.58, 27.84, " в"], [27.84, 28.36, " предыдущем"], [28.36, 28.74, " пункте"], [28.74, 28.96, " мы"], [28.96, 29.34, " говорили"], [29.34, 29.56, " о"], [29.56, 29.98, " миллионе"]]}, {"start": 29.98, "end": 34.0, "text": "как о вашем трамплине, который позволяет запрыгнуть в новое для себя начинание,", "words": [[29.98, 30.14, " как"], [30.14, 30.32, " о"], [30.32, 30.66, " вашем"], [30.66, 31.28, " трамплине,"], [31.48, 31.64, " который"], [31.64, 32.1, " позволяет"], [32.1, 32.6, " запрыгнуть"], [32.6, 32.8, " в"], [32.8, 33.04, " новое"], [33.04, 33.14, " для"], [33.14, 33.4, " себя"], [33.4, 34.0, " начинание,"]]}, {"start": 34.14, "end": 39.14, "text": "то сейчас надо поговорить о нём как о фундаменте. Потому что какой смысл ловить возможности,", "words": [[34.14, 34.32, " то"], [34.32, 34.56, " сейчас"], [34.56, 34.8, " надо"], [34.8, 35.48, " поговорить"], [35.48, 35.94, " о"], [35.94, 36.26, " нём"], [36.26, 36.48, " как"], [36.48, 36.56, " о"], [36.56, 37.32, " фундаменте."], [37.36, 37.56, " Потому"], [37.56, 37.78, " что"], [37.78, 37.88, " какой"], [37.88, 38.28, " смысл"], [38.28, 38.54, " ловить"], [38.54, 39.14, " возможности,"]]}, {"start": 39.16, "end": 45.3, "text": "если любая бытовая яма может выбить вас из колеи на полгода. И это подводит нас к четвёртой,", "words": [[39.16, 39.46, " если"], [39.46, 39.74, " любая"], [39.74, 40.2, " бытовая"], [40.2, 40.5, " яма"], [40.5, 40.88, " может"], [40.88, 41.3, " выбить"], [41.3, 41.64, " вас"], [41.64, 41.86, " из"], [41.86, 42.28, " колеи"], [42.28, 42.44, " на"], [42.44, 43.36, " полгода."], [43.52, 43.66, " И"], [43.66, 43.8, " это"], [43.8, 44.14, " подводит"], [44.14, 44.28, " нас"], [44.28, 44.48, " к"], [44.48, 45.3, " четвёртой,"]]}, {"start": 45.38, "end": 47.8, "text": "самой приземлённой, но жизненно важной причине.", "words": [[45.38, 45.7, " самой"], [45.7, 46.38, " приземлённой,"], [46.48, 46.64, " но"], [46.64, 46.98, " жизненно"], [46.98, 47.3, " важной"], [47.3, 47.8, " причине."]]}, {"start": 47.92, "end": 51.76, "text": "Четвёртый пункт — это безопасность. Давайте признаем, что 90% того,", "words": [[47.92, 48.3, " Четвёртый"], [48.3, 48.58, " пункт"], [48.58, 48.68, " —"], [48.68, 48.84, " это"], [48.84, 49.42, " безопасность."], [49.62, 49.92, " Давайте"], [49.92, 50.28, " признаем,"], [50.38, 50.6, " что"], [50.6, 51.04, " 90"], [51.04, 51.48, "%"], [51.48, 51.76, " того,"]]}, {"start": 51.84, "end": 55.72, "text": "что мы привыкли называть жизненными трагедиями — это на самом деле просто", "words": [[51.84, 52.02, " что"], [52.02, 52.28, " мы"], [52.28, 52.66, " привыкли"], [52.66, 53.08, " называть"], [53.08, 53.64, " жизненными"], [53.64, 54.44, " трагедиями"], [54.44, 54.64, " —"], [54.64, 54.76, " это"], [54.76, 54.8, " на"], [54.8, 55.1, " самом"], [55.1, 55.32, " деле"], [55.32, 55.72, " просто"]]}, {"start": 55.72, "end": 61.88, "text": "предвиденные расходы. Сломалась машина, заболел зуб, залили соседи, не дай бог заболел кто-то из", "words": [[55.72, 56.36, " предвиденные"], [56.36, 57.06, " расходы."], [57.1, 57.5, " Сломалась"], [57.5, 58.14, " машина,"], [58.38, 58.72, " заболел"], [58.72, 59.16, " зуб,"], [59.52, 59.92, " залили"], [59.92, 60.54, " соседи,"], [60.78, 60.88, " не"], [60.88, 61.0, " дай"], [61.0, 61.12, " бог"], [61.12, 61.5, " заболел"], [61.5, 61.66, " кто"], [61.66, 61.74, "-то"], [61.74, 61.88, " из"]]}, {"start": 61.88, "end": 67.12, "text": "родственников. Для человека без накоплений всё это — это чрезвычайное происшествие, драма,", "words": [[61.88, 62.42, " родственников."], [62.48, 62.62, " Для"], [62.62, 62.96, " человека"], [62.96, 63.22, " без"], [63.22, 63.88, " накоплений"], [63.88, 64.22, " всё"], [64.22, 64.7, " это"], [64.7, 64.98, " —"], [64.98, 65.16, " это"], [65.16, 65.7, " чрезвычайное"], [65.7, 66.38, " происшествие,"], [66.58, 67.12, " драма,"]]}, {"start": 67.34, "end": 71.98, "text": "стресс, скорее всего, какой-нибудь кабальный кредит и всё такое. Когда у вас на счету есть миллион,", "words": [[67.34, 67.9, " стресс,"], [68.12, 68.28, " скорее"], [68.28, 68.58, " всего,"], [68.7, 68.72, " какой"], [68.72, 68.98, "-нибудь"], [68.98, 69.44, " кабальный"], [69.44, 69.8, " кредит"], [69.8, 69.92, " и"], [69.92, 70.04, " всё"], [70.04, 70.32, " такое."], [70.54, 70.76, " Когда"], [70.76, 70.9, " у"], [70.9, 71.04, " вас"], [71.04, 71.16, " на"], [71.16, 71.4, " счету"], [71.4, 71.62, " есть"], [71.62, 71.98, " миллион,"]]}, {"start": 72.28, "end": 77.34, "text": "характер этих событий меняется радикально. Миллион превращает вот эту катастрофу в обычную", "words": [[72.28, 72.4, " характер"], [72.4, 72.8, " этих"], [72.8, 73.3, " событий"], [73.3, 73.8, " меняется"], [73.8, 74.42, " радикально."], [74.62, 75.14, " Миллион"], [75.14, 75.74, " превращает"], [75.74, 75.86, " вот"], [75.86, 75.98, " эту"], [75.98, 76.78, " катастрофу"], [76.78, 76.94, " в"], [76.94, 77.34, " обычную"]]}, {"start": 77.34, "end": 82.2, "text": "статью расходов. Да, неприятную, но тем не менее. Вы больше не тратите свои нервные клетки", "words": [[77.34, 77.66, " статью"], [77.66, 78.16, " расходов."], [78.22, 78.5, " Да,"], [78.56, 79.26, " неприятную,"], [79.28, 79.44, " но"], [79.44, 79.66, " тем"], [79.66, 79.82, " не"], [79.82, 80.04, " менее."], [80.2, 80.48, " Вы"], [80.48, 80.8, " больше"], [80.8, 81.0, " не"], [81.0, 81.34, " тратите"], [81.34, 81.52, " свои"], [81.52, 81.9, " нервные"], [81.9, 82.2, " клетки"]]}, {"start": 82.2, "end": 87.7, "text": "на панику, вы просто решаете вопрос с деньгами. Вы осознаёте, что практически любое бытовое или", "words": [[82.2, 82.44, " на"], [82.44, 82.78, " панику,"], [82.86, 83.04, " вы"], [83.04, 83.36, " просто"], [83.36, 83.68, " решаете"], [83.68, 83.9, " вопрос"], [83.9, 84.0, " с"], [84.0, 84.5, " деньгами."], [84.7, 84.88, " Вы"], [84.88, 85.34, " осознаёте,"], [85.64, 85.78, " что"], [85.78, 86.36, " практически"], [86.36, 86.82, " любое"], [86.82, 87.48, " бытовое"], [87.48, 87.7, " или"]]}, {"start": 87.7, "end": 92.8, "text": "медицинское ЧП, которое может у вас случиться, укладывается в сумму до 1 миллиона рублей.", "words": [[87.7, 88.32, " медицинское"], [88.32, 88.62, " ЧП,"], [88.7, 88.94, " которое"], [88.94, 89.24, " может"], [89.24, 89.34, " у"], [89.34, 89.54, " вас"], [89.54, 90.26, " случиться,"], [90.48, 91.04, " укладывается"], [91.04, 91.22, " в"], [91.22, 91.52, " сумму"], [91.52, 91.76, " до"], [91.76, 92.02, " 1"], [92.02, 92.44, " миллиона"], [92.44, 92.8, " рублей."]]}, {"start": 93.04, "end": 98.16, "text": "С безопасностью, я думаю, всё понятно, но знаете, что может быть ещё важнее от ремонтированной", "words": [[93.04, 93.16, " С"], [93.16, 93.86, " безопасностью,"], [93.92, 94.02, " я"], [94.02, 94.16, " думаю,"], [94.22, 94.38, " всё"], [94.38, 94.8, " понятно,"], [95.18, 95.38, " но"], [95.38, 95.62, " знаете,"], [95.82, 96.12, " что"], [96.12, 96.3, " может"], [96.3, 96.66, " быть"], [96.66, 97.02, " ещё"], [97.02, 97.42, " важнее"], [97.42, 97.58, " от"], [97.58, 98.16, " ремонтированной"]]}, {"start": 98.16, "end": 103.04, "text": "машины или оплаченного стоматолога — это вот то, что происходит у нас в голове, когда эти", "words": [[98.16, 98.64, " машины"], [98.64, 98.96, " или"], [98.96, 99.46, " оплаченного"], [99.46, 100.32, " стоматолога"], [100.32, 100.56, " —"], [100.56, 100.72, " это"], [100.72, 100.96, " вот"], [100.96, 101.08, " то,"], [101.1, 101.32, " что"], [101.32, 101.7, " происходит"], [101.7, 101.7, " у"], [101.7, 101.96, " нас"], [101.96, 102.14, " в"], [102.14, 102.42, " голове,"], [102.52, 102.78, " когда"], [102.78, 103.04, " эти"]]}, {"start": 103.04, "end": 108.94, "text": "деньги просто лежат на счету. Это подводит нас к пятой причине — смена психологического", "words": [[103.04, 103.32, " деньги"], [103.32, 103.74, " просто"], [103.74, 104.0, " лежат"], [104.0, 104.14, " на"], [104.14, 104.5, " счету."], [105.66, 105.86, " Это"], [105.86, 106.16, " подводит"], [106.16, 106.28, " нас"], [106.28, 106.4, " к"], [106.4, 106.66, " пятой"], [106.66, 107.32, " причине"], [107.32, 107.54, " —"], [107.54, 108.0, " смена"], [108.0, 108.94, " психологического"]]}, {"start": 108.94, "end": 114.32, "text": "состояния. Эта проблема мне по-человечески очень близка, не знаю, согласитесь вы со мной или нет,", "words": [[108.94, 109.76, " состояния."], [110.0, 110.14, " Эта"], [110.14, 110.5, " проблема"], [110.5, 110.82, " мне"], [110.82, 111.0, " по"], [111.0, 111.54, "-человечески"], [111.54, 111.8, " очень"], [111.8, 112.38, " близка,"], [112.66, 112.82, " не"], [112.82, 112.98, " знаю,"], [113.16, 113.52, " согласитесь"], [113.52, 113.66, " вы"], [113.66, 113.7, " со"], [113.7, 113.9, " мной"], [113.9, 114.08, " или"], [114.08, 114.32, " нет,"]]}, {"start": 114.46, "end": 119.18, "text": "но я глубоко убеждён, что стресс от недостатка денег — это самый сильный стресс, который можно", "words": [[114.46, 114.68, " но"], [114.68, 114.88, " я"], [114.88, 115.22, " глубоко"], [115.22, 115.66, " убеждён,"], [115.82, 116.1, " что"], [116.1, 116.42, " стресс"], [116.42, 116.54, " от"], [116.54, 117.06, " недостатка"], [117.06, 117.38, " денег"], [117.38, 117.68, " —"], [117.68, 117.92, " это"], [117.92, 118.04, " самый"], [118.04, 118.4, " сильный"], [118.4, 118.66, " стресс,"], [118.84, 118.88, " который"], [118.88, 119.18, " можно"]]}, {"start": 119.18, "end": 124.86, "text": "испытывать на длительном отрезке. Он обычно делится на два подвида. Первый — это стресс от того,", "words": [[119.18, 119.64, " испытывать"], [119.64, 119.8, " на"], [119.8, 120.2, " длительном"], [120.2, 120.74, " отрезке."], [121.0, 121.2, " Он"], [121.2, 121.8, " обычно"], [121.8, 122.18, " делится"], [122.18, 122.44, " на"], [122.44, 122.6, " два"], [122.6, 123.46, " подвида."], [123.54, 123.96, " Первый"], [123.96, 124.16, " —"], [124.16, 124.28, " это"], [124.28, 124.58, " стресс"], [124.58, 124.7, " от"], [124.7, 124.86, " того,"]]}, {"start": 124.96, "end": 129.72, "text": "что ты не можешь себе позволить какие-то необходимые вещи, например обязательные лекарства или крышу", "words": [[124.96, 125.06, " что"], [125.06, 125.18, " ты"], [125.18, 125.34, " не"], [125.34, 125.5, " можешь"], [125.5, 125.78, " себе"], [125.78, 126.26, " позволить"], [126.26, 126.48, " какие"], [126.48, 126.66, "-то"], [126.66, 127.24, " необходимые"], [127.24, 127.6, " вещи,"], [127.94, 128.24, " например"], [128.24, 128.76, " обязательные"], [128.76, 129.2, " лекарства"], [129.2, 129.36, " или"], [129.36, 129.72, " крышу"]]}, {"start": 129.72, "end": 133.72, "text": "над головой. А второй — это стресс от ощущения того, что ты должен кому-то денег,", "words": [[129.72, 129.82, " над"], [129.82, 130.3, " головой."], [130.48, 130.76, " А"], [130.76, 131.02, " второй"], [131.02, 131.16, " —"], [131.16, 131.3, " это"], [131.3, 131.64, " стресс"], [131.64, 131.84, " от"], [131.84, 132.34, " ощущения"], [132.34, 132.5, " того,"], [132.6, 132.72, " что"], [132.72, 132.86, " ты"], [132.86, 133.12, " должен"], [133.12, 133.32, " кому"], [133.32, 133.54, "-то"], [133.54, 133.72, " денег,"]]}, {"start": 133.94, "end": 138.12, "text": "который не можешь отдать. Тут обычно целый букет эмоций, там страх потерять репутацию,", "words": [[133.94, 134.04, " который"], [134.04, 134.26, " не"], [134.26, 134.4, " можешь"], [134.4, 134.8, " отдать."], [134.92, 135.1, " Тут"], [135.1, 135.46, " обычно"], [135.46, 135.74, " целый"], [135.74, 136.08, " букет"], [136.08, 136.5, " эмоций,"], [136.68, 136.86, " там"], [136.86, 137.0, " страх"], [137.0, 137.42, " потерять"], [137.42, 138.12, " репутацию,"]]}, {"start": 138.12, "end": 143.36, "text": "социальный статус, возможно, жену или девушку и так далее. Короче, я сам через всё это прошёл,", "words": [[138.12, 138.74, " социальный"], [138.74, 139.4, " статус,"], [139.84, 139.94, " возможно,"], [140.12, 140.3, " жену"], [140.3, 140.44, " или"], [140.44, 140.88, " девушку"], [140.88, 140.98, " и"], [140.98, 141.16, " так"], [141.16, 141.4, " далее."], [141.6, 141.92, " Короче,"], [142.14, 142.22, " я"], [142.22, 142.4, " сам"], [142.4, 142.6, " через"], [142.6, 142.76, " всё"], [142.76, 142.98, " это"], [142.98, 143.36, " прошёл,"]]}, {"start": 143.6, "end": 147.38, "text": "и каждой клеткой своего тела прочувствовал все эти эмоции. В какой-то степени, наверное,", "words": [[143.6, 143.76, " и"], [143.76, 143.94, " каждой"], [143.94, 144.24, " клеткой"], [144.24, 144.52, " своего"], [144.52, 144.84, " тела"], [144.84, 145.36, " прочувствовал"], [145.36, 145.52, " все"], [145.52, 145.66, " эти"], [145.66, 146.04, " эмоции."], [146.12, 146.24, " В"], [146.24, 146.38, " какой"], [146.38, 146.56, "-то"], [146.56, 146.96, " степени,"], [146.98, 147.38, " наверное,"]]}, {"start": 147.6, "end": 151.62, "text": "именно они стали драйвером к тому, чтобы я начал наводить порядок в своих финансах несколько", "words": [[147.6, 147.72, " именно"], [147.72, 147.98, " они"], [147.98, 148.24, " стали"], [148.24, 148.74, " драйвером"], [148.74, 148.86, " к"], [148.86, 148.98, " тому,"], [149.12, 149.24, " чтобы"], [149.24, 149.66, " я"], [149.66, 149.66, " начал"], [149.66, 149.96, " наводить"], [149.96, 150.28, " порядок"], [150.28, 150.4, " в"], [150.4, 150.52, " своих"], [150.52, 151.2, " финансах"], [151.2, 151.62, " несколько"]]}, {"start": 151.62, "end": 157.08, "text": "лет назад. А есть такой дядька — Эльдар Шефир. У него есть целый ряд исследований на эту тему,", "words": [[151.62, 151.82, " лет"], [151.82, 152.12, " назад."], [152.3, 152.56, " А"], [152.56, 152.72, " есть"], [152.72, 152.96, " такой"], [152.96, 153.6, " дядька"], [153.6, 153.68, " —"], [153.68, 154.06, " Эльдар"], [154.06, 154.4, " Шефир."], [154.52, 154.64, " У"], [154.64, 154.88, " него"], [154.88, 155.3, " есть"], [155.3, 155.64, " целый"], [155.64, 155.82, " ряд"], [155.82, 156.42, " исследований"], [156.42, 156.58, " на"], [156.58, 156.72, " эту"], [156.72, 157.08, " тему,"]]}, {"start": 157.34, "end": 162.02, "text": "я прямо настоятельно рекомендую вам посмотреть его творчество на ютубе, очень хорошо отрезывает.", "words": [[157.34, 157.62, " я"], [157.62, 157.84, " прямо"], [157.84, 158.46, " настоятельно"], [158.46, 158.94, " рекомендую"], [158.94, 159.14, " вам"], [159.14, 159.58, " посмотреть"], [159.58, 159.74, " его"], [159.74, 160.26, " творчество"], [160.26, 160.4, " на"], [160.4, 160.9, " ютубе,"], [160.96, 161.22, " очень"], [161.22, 161.48, " хорошо"], [161.48, 162.02, " отрезывает."]]}, {"start": 162.2, "end": 167.18, "text": "Можно начать с его выступления на теде, там контента на 14 минут, а пользы на годы", "words": [[162.2, 162.46, " Можно"], [162.46, 162.78, " начать"], [162.78, 162.88, " с"], [162.88, 163.04, " его"], [163.04, 163.5, " выступления"], [163.5, 163.66, " на"], [163.66, 164.08, " теде,"], [164.22, 164.38, " там"], [164.38, 164.78, " контента"], [164.78, 164.96, " на"], [164.96, 165.26, " 14"], [165.26, 165.66, " минут,"], [165.86, 166.08, " а"], [166.08, 166.44, " пользы"], [166.44, 166.74, " на"], [166.74, 167.18, " годы"]]}, {"start": 167.9, "end": 173.02, "text": "К слову, об интересе большей части населения к теме финансовой грамотности ролик опубликован", "words": [[167.9, 168.2, " К"], [168.2, 169.0, " слову,"], [169.06, 169.16, " об"], [169.16, 169.6, " интересе"], [169.6, 169.82, " большей"], [169.82, 170.04, " части"], [170.04, 170.58, " населения"], [170.58, 170.72, " к"], [170.72, 170.9, " теме"], [170.9, 171.34, " финансовой"], [171.34, 172.02, " грамотности"], [172.02, 172.44, " ролик"], [172.44, 173.02, " опубликован"]]}, {"start": 173.02, "end": 178.78, "text": "14 лет назад, на нём за всё это время 60 тысяч просмотров. А так вот, у него есть такой термин", "words": [[173.02, 173.44, " 14"], [173.44, 173.76, " лет"], [173.76, 174.2, " назад,"], [174.3, 174.44, " на"], [174.44, 174.62, " нём"], [174.62, 174.76, " за"], [174.76, 174.9, " всё"], [174.9, 175.06, " это"], [175.06, 175.28, " время"], [175.28, 175.66, " 60"], [175.66, 175.98, " тысяч"], [175.98, 176.72, " просмотров."], [176.86, 177.04, " А"], [177.04, 177.2, " так"], [177.2, 177.42, " вот,"], [177.48, 177.56, " у"], [177.56, 177.8, " него"], [177.8, 178.06, " есть"], [178.06, 178.22, " такой"], [178.22, 178.78, " термин"]]}, {"start": 178.78, "end": 183.14, "text": "«дефицитное мышление». Суть в том, что когда человек живёт в состоянии острой нехватки", "words": [[178.78, 179.36, " «дефицитное"], [179.36, 180.14, " мышление»."], [180.14, 180.42, " Суть"], [180.42, 180.54, " в"], [180.54, 180.7, " том,"], [180.86, 181.02, " что"], [181.02, 181.22, " когда"], [181.22, 181.48, " человек"], [181.48, 181.78, " живёт"], [181.78, 181.9, " в"], [181.9, 182.4, " состоянии"], [182.4, 182.72, " острой"], [182.72, 183.14, " нехватки"]]}, {"start": 183.14, "end": 188.42, "text": "ресурса, его мозг переходит в режим так называемого туннельного зрения, снижаются умственные и", "words": [[183.14, 183.62, " ресурса,"], [183.78, 183.88, " его"], [183.88, 184.18, " мозг"], [184.18, 184.56, " переходит"], [184.56, 184.68, " в"], [184.68, 184.88, " режим"], [184.88, 185.08, " так"], [185.08, 185.66, " называемого"], [185.66, 186.2, " туннельного"], [186.2, 186.66, " зрения,"], [186.98, 187.48, " снижаются"], [187.48, 188.2, " умственные"], [188.2, 188.42, " и"]]}, {"start": 188.42, "end": 193.92, "text": "когнитивные способности. Тесты на IQ в моменты финансового стресса показывают падение в", "words": [[188.42, 189.04, " когнитивные"], [189.04, 189.72, " способности."], [189.82, 190.3, " Тесты"], [190.3, 190.54, " на"], [190.54, 190.96, " IQ"], [190.96, 191.28, " в"], [191.28, 191.7, " моменты"], [191.7, 192.16, " финансового"], [192.16, 192.78, " стресса"], [192.78, 193.16, " показывают"], [193.16, 193.62, " падение"], [193.62, 193.92, " в"]]}, {"start": 194.3, "end": 200.46, "text": "13-14 пунктов. Ну то есть, вы буквально тупеете, когда испытываете стресс от недостатка денег. Это", "words": [[194.3, 194.58, " 13"], [194.58, 195.24, "-14"], [195.24, 195.94, " пунктов."], [196.0, 196.14, " Ну"], [196.14, 196.18, " то"], [196.18, 196.44, " есть,"], [196.64, 196.72, " вы"], [196.72, 197.24, " буквально"], [197.24, 197.74, " тупеете,"], [197.82, 198.0, " когда"], [198.0, 198.6, " испытываете"], [198.6, 198.92, " стресс"], [198.92, 199.06, " от"], [199.06, 199.6, " недостатка"], [199.6, 199.94, " денег."], [200.12, 200.46, " Это"]]}, {"start": 200.46, "end": 205.16, "text": "равносильно бессонные ночи и для состояния лёгкого алкогольного опьянения. Когда у вас ноль", "words": [[200.46, 200.9, " равносильно"], [200.9, 201.4, " бессонные"], [201.4, 201.88, " ночи"], [201.88, 202.1, " и"], [202.1, 202.18, " для"], [202.18, 202.72, " состояния"], [202.72, 203.1, " лёгкого"], [203.1, 203.64, " алкогольного"], [203.64, 204.16, " опьянения."], [204.38, 204.56, " Когда"], [204.56, 204.64, " у"], [204.64, 204.88, " вас"], [204.88, 205.16, " ноль"]]}, {"start": 205.16, "end": 210.84, "text": "на счету, вы физически не способны принимать мудрые и долгосроченные решения. Вы видите только", "words": [[205.16, 205.36, " на"], [205.36, 205.72, " счету,"], [205.82, 206.1, " вы"], [206.1, 206.7, " физически"], [206.7, 206.88, " не"], [206.88, 207.28, " способны"], [207.28, 207.74, " принимать"], [207.74, 208.34, " мудрые"], [208.34, 208.54, " и"], [208.54, 209.18, " долгосроченные"], [209.18, 209.66, " решения."], [209.98, 210.22, " Вы"], [210.22, 210.5, " видите"], [210.5, 210.84, " только"]]}, {"start": 210.84, "end": 215.5, "text": "то, что прямо перед носом. Как дотянуть до зарплаты, как перехватить до зарплаты или", "words": [[210.84, 211.1, " то,"], [211.18, 211.44, " что"], [211.44, 211.72, " прямо"], [211.72, 211.94, " перед"], [211.94, 212.44, " носом."], [212.56, 212.76, " Как"], [212.76, 213.12, " дотянуть"], [213.12, 213.26, " до"], [213.26, 213.72, " зарплаты,"], [213.74, 213.96, " как"], [213.96, 214.54, " перехватить"], [214.54, 214.68, " до"], [214.68, 215.3, " зарплаты"], [215.3, 215.5, " или"]]}, {"start": 215.5, "end": 219.96, "text": "как закрыть финансовую дыру. Психологический комфорт от семизначной суммы на счету даёт вам", "words": [[215.5, 215.72, " как"], [215.72, 215.98, " закрыть"], [215.98, 216.4, " финансовую"], [216.4, 216.72, " дыру."], [217.02, 217.56, " Психологический"], [217.56, 218.02, " комфорт"], [218.02, 218.18, " от"], [218.18, 218.72, " семизначной"], [218.72, 218.98, " суммы"], [218.98, 219.1, " на"], [219.1, 219.32, " счету"], [219.32, 219.62, " даёт"], [219.62, 219.96, " вам"]]}, {"start": 219.96, "end": 224.54, "text": "самое главное преимущество в капиталистическом мире, это трезвый рассудок. Вы перестаёте", "words": [[219.96, 220.2, " самое"], [220.2, 220.58, " главное"], [220.58, 221.28, " преимущество"], [221.28, 221.42, " в"], [221.42, 222.2, " капиталистическом"], [222.2, 222.48, " мире,"], [222.82, 222.9, " это"], [222.9, 223.24, " трезвый"], [223.24, 223.78, " рассудок."], [223.88, 224.06, " Вы"], [224.06, 224.54, " перестаёте"]]}, {"start": 224.54, "end": 228.14, "text": "совершать импульсивные ошибки на панике, которые обычно и стоят людям.", "words": [[224.54, 224.94, " совершать"], [224.94, 225.54, " импульсивные"], [225.54, 225.88, " ошибки"], [225.88, 226.04, " на"], [226.04, 226.48, " панике,"], [226.68, 226.86, " которые"], [226.86, 227.4, " обычно"], [227.4, 227.68, " и"], [227.68, 227.9, " стоят"], [227.9, 228.14, " людям."]]}]