[{"start": 0.0, "end": 3.28, "text": "Лет 10 назад я был уверен, если у меня на счету будет", "words": [[0.0, 0.48, " Лет"], [0.48, 0.74, " 10"], [0.74, 1.08, " назад"], [1.08, 1.32, " я"], [1.32, 1.48, " был"], [1.48, 1.92, " уверен,"], [2.0, 2.3, " если"], [2.3, 2.36, " у"], [2.36, 2.58, " меня"], [2.58, 2.7, " на"], [2.7, 2.98, " счету"], [2.98, 3.28, " будет"]]}, {"start": 3.28, "end": 6.12, "text": "миллион рублей, я официально стану богатым человеком.", "words": [[3.28, 3.66, " миллион"], [3.66, 4.02, " рублей,"], [4.22, 4.42, " я"], [4.42, 4.88, " официально"], [4.88, 5.14, " стану"], [5.14, 5.58, " богатым"], [5.58, 6.12, " человеком."]]}, {"start": 6.2, "end": 8.58, "text": "Не так давно я наконец-то побил эту отметку, и знаете", "words": [[6.2, 6.34, " Не"], [6.34, 6.46, " так"], [6.46, 6.62, " давно"], [6.62, 6.76, " я"], [6.76, 7.02, " наконец"], [7.02, 7.24, "-то"], [7.24, 7.46, " побил"], [7.46, 7.64, " эту"], [7.64, 8.12, " отметку,"], [8.28, 8.4, " и"], [8.4, 8.58, " знаете"]]}, {"start": 8.58, "end": 9.3, "text": "что я осознал?", "words": [[8.58, 8.8, " что"], [8.8, 9.0, " я"], [9.0, 9.3, " осознал?"]]}, {"start": 9.56, "end": 11.86, "text": "На миллион сегодня нельзя купить почти ничего.", "words": [[9.56, 9.72, " На"], [9.72, 10.04, " миллион"], [10.04, 10.46, " сегодня"], [10.46, 10.78, " нельзя"], [10.78, 11.14, " купить"], [11.14, 11.46, " почти"], [11.46, 11.86, " ничего."]]}, {"start": 12.4, "end": 14.34, "text": "Этого не хватит даже на первый взнос по ипотеке", "words": [[12.4, 12.62, " Этого"], [12.62, 12.8, " не"], [12.8, 13.0, " хватит"], [13.0, 13.2, " даже"], [13.2, 13.38, " на"], [13.38, 13.54, " первый"], [13.54, 13.78, " взнос"], [13.78, 13.94, " по"], [13.94, 14.34, " ипотеке"]]}, {"start": 14.34, "end": 15.26, "text": "в крупном городе.", "words": [[14.34, 14.48, " в"], [14.48, 14.8, " крупном"], [14.8, 15.26, " городе."]]}, {"start": 15.44, "end": 17.64, "text": "В автосалоне, например, за эти деньги вам предложат", "words": [[15.44, 15.56, " В"], [15.56, 16.04, " автосалоне,"], [16.06, 16.4, " например,"], [16.48, 16.56, " за"], [16.56, 16.72, " эти"], [16.72, 16.98, " деньги"], [16.98, 17.2, " вам"], [17.2, 17.64, " предложат"]]}, {"start": 17.64, "end": 20.32, "text": "разве что пустую комплектацию самого бюджетного авто", "words": [[17.64, 17.88, " разве"], [17.88, 18.02, " что"], [18.02, 18.32, " пустую"], [18.32, 18.96, " комплектацию"], [18.96, 19.28, " самого"], [19.28, 19.8, " бюджетного"], [19.8, 20.32, " авто"]]}, {"start": 20.32, "end": 22.14, "text": "даже без подушек безопасности.", "words": [[20.32, 20.72, " даже"], [20.72, 21.0, " без"], [21.0, 21.38, " подушек"], [21.38, 22.14, " безопасности."]]}, {"start": 22.34, "end": 25.76, "text": "По факту, миллион в 2026 году – это просто пачка", "words": [[22.34, 22.52, " По"], [22.52, 22.96, " факту,"], [23.16, 23.42, " миллион"], [23.42, 23.44, " в"], [23.44, 24.24, " 2026"], [24.24, 24.58, " году"], [24.58, 24.96, " –"], [24.96, 25.06, " это"], [25.06, 25.4, " просто"], [25.4, 25.76, " пачка"]]}, {"start": 25.76, "end": 28.18, "text": "бумаги, которая не делает вас миллионером в старом", "words": [[25.76, 26.16, " бумаги,"], [26.32, 26.46, " которая"], [26.46, 26.7, " не"], [26.7, 26.88, " делает"], [26.88, 27.12, " вас"], [27.12, 27.64, " миллионером"], [27.64, 27.9, " в"], [27.9, 28.18, " старом"]]}, {"start": 28.18, "end": 29.04, "text": "смысле этого слова.", "words": [[28.18, 28.52, " смысле"], [28.52, 28.84, " этого"], [28.84, 29.04, " слова."]]}, {"start": 29.04, "end": 32.32, "text": "Естественно, я испытал некое разочарование от происходящего,", "words": [[29.04, 29.94, " Естественно,"], [30.18, 30.26, " я"], [30.26, 30.58, " испытал"], [30.58, 30.9, " некое"], [30.9, 31.5, " разочарование"], [31.5, 31.7, " от"], [31.7, 32.32, " происходящего,"]]}, {"start": 32.44, "end": 33.6, "text": "но копить не перестал.", "words": [[32.44, 32.56, " но"], [32.56, 32.82, " копить"], [32.82, 33.02, " не"], [33.02, 33.6, " перестал."]]}, {"start": 33.78, "end": 36.74, "text": "Сегодня, с того дня прошло уже около 5 лет, и оглядываясь", "words": [[33.78, 34.16, " Сегодня,"], [34.22, 34.3, " с"], [34.3, 34.42, " того"], [34.42, 34.66, " дня"], [34.66, 35.04, " прошло"], [35.04, 35.2, " уже"], [35.2, 35.38, " около"], [35.38, 35.62, " 5"], [35.62, 35.86, " лет,"], [36.1, 36.22, " и"], [36.22, 36.74, " оглядываясь"]]}, {"start": 36.74, "end": 40.06, "text": "назад, я вижу, что радикальные изменения в моей жизни начались", "words": [[36.74, 36.98, " назад,"], [37.16, 37.3, " я"], [37.3, 37.44, " вижу,"], [37.64, 37.78, " что"], [37.78, 38.34, " радикальные"], [38.34, 38.82, " изменения"], [38.82, 39.0, " в"], [39.0, 39.12, " моей"], [39.12, 39.52, " жизни"], [39.52, 40.06, " начались"]]}, {"start": 40.06, "end": 42.48, "text": "именно с момента появления миллиона рублей на банковском", "words": [[40.06, 40.38, " именно"], [40.38, 40.56, " с"], [40.56, 40.92, " момента"], [40.92, 41.26, " появления"], [41.26, 41.66, " миллиона"], [41.66, 41.9, " рублей"], [41.9, 42.02, " на"], [42.02, 42.48, " банковском"]]}, {"start": 42.48, "end": 43.02, "text": "счету.", "words": [[42.48, 43.02, " счету."]]}, {"start": 43.1, "end": 45.12, "text": "Сегодня я расскажу вам о семи причинах, почему", "words": [[43.1, 43.38, " Сегодня"], [43.38, 43.56, " я"], [43.56, 43.86, " расскажу"], [43.86, 44.0, " вам"], [44.0, 44.08, " о"], [44.08, 44.38, " семи"], [44.38, 44.8, " причинах,"], [44.92, 45.12, " почему"]]}, {"start": 45.12, "end": 47.94, "text": "этот, в кавычках, бесполезный миллион – это буквально", "words": [[45.12, 45.44, " этот,"], [45.44, 45.58, " в"], [45.58, 46.02, " кавычках,"], [46.18, 46.68, " бесполезный"], [46.68, 47.1, " миллион"], [47.1, 47.34, " –"], [47.34, 47.46, " это"], [47.46, 47.94, " буквально"]]}, {"start": 47.94, "end": 50.22, "text": "самая важная финансовая цель в вашей жизни.", "words": [[47.94, 48.3, " самая"], [48.3, 48.74, " важная"], [48.74, 49.28, " финансовая"], [49.28, 49.46, " цель"], [49.46, 49.66, " в"], [49.66, 49.88, " вашей"], [49.88, 50.22, " жизни."]]}, {"start": 50.4, "end": 52.4, "text": "В этом видео я не буду учить вас откладывать", "words": [[50.4, 50.56, " В"], [50.56, 50.68, " этом"], [50.68, 50.94, " видео"], [50.94, 51.12, " я"], [51.12, 51.26, " не"], [51.26, 51.4, " буду"], [51.4, 51.64, " учить"], [51.64, 51.84, " вас"], [51.84, 52.4, " откладывать"]]}, {"start": 52.4, "end": 55.1, "text": "по 100 рублей в день, мы коротко и внятно разберем", "words": [[52.4, 52.62, " по"], [52.62, 52.76, " 100"], [52.76, 53.0, " рублей"], [53.0, 53.18, " в"], [53.18, 53.34, " день,"], [53.52, 53.82, " мы"], [53.82, 54.18, " коротко"], [54.18, 54.28, " и"], [54.28, 54.5, " внятно"], [54.5, 55.1, " разберем"]]}, {"start": 55.1, "end": 58.12, "text": "7 вещей, которые я осознал только тогда, когда на", "words": [[55.1, 55.32, " 7"], [55.32, 55.72, " вещей,"], [55.96, 56.06, " которые"], [56.06, 56.32, " я"], [56.32, 56.66, " осознал"], [56.66, 56.98, " только"], [56.98, 57.42, " тогда,"], [57.62, 57.88, " когда"], [57.88, 58.12, " на"]]}, {"start": 58.12, "end": 60.02, "text": "банковском счету появилась семизначная сумма.", "words": [[58.12, 58.24, " банковском"], [58.24, 58.54, " счету"], [58.54, 58.96, " появилась"], [58.96, 59.62, " семизначная"], [59.62, 60.02, " сумма."]]}, {"start": 60.12, "end": 62.72, "text": "В конце видео у вас будет полное понимание того, почему", "words": [[60.12, 60.18, " В"], [60.18, 60.4, " конце"], [60.4, 60.68, " видео"], [60.68, 60.68, " у"], [60.68, 60.96, " вас"], [60.96, 61.32, " будет"], [61.32, 61.74, " полное"], [61.74, 62.16, " понимание"], [62.16, 62.34, " того,"], [62.54, 62.72, " почему"]]}, {"start": 62.72, "end": 65.1, "text": "накопить миллион – это не просто интересный и", "words": [[62.72, 63.18, " накопить"], [63.18, 63.54, " миллион"], [63.54, 63.68, " –"], [63.68, 63.82, " это"], [63.82, 63.96, " не"], [63.96, 64.22, " просто"], [64.22, 64.9, " интересный"], [64.9, 65.1, " и"]]}, {"start": 65.1, "end": 67.9, "text": "чрезвычайно сложный челлендж, а жизненная необходимость", "words": [[65.1, 65.84, " чрезвычайно"], [65.84, 66.18, " сложный"], [66.18, 66.62, " челлендж,"], [66.78, 66.9, " а"], [66.9, 67.28, " жизненная"], [67.28, 67.9, " необходимость"]]}, {"start": 67.9, "end": 69.42, "text": "для любого человека в наше время.", "words": [[67.9, 68.14, " для"], [68.14, 68.46, " любого"], [68.46, 68.8, " человека"], [68.8, 68.98, " в"], [68.98, 69.18, " наше"], [69.18, 69.42, " время."]]}, {"start": 69.64, "end": 72.24, "text": "Лайк, подписка, авансом – поехали.", "words": [[69.64, 70.02, " Лайк,"], [70.1, 70.48, " подписка,"], [70.54, 71.16, " авансом"], [71.16, 71.66, " –"], [71.66, 72.24, " поехали."]]}, {"start": 77.02, "end": 79.46, "text": "Первая причина, самая приятная и одновременно", "words": [[77.02, 77.4, " Первая"], [77.4, 77.86, " причина,"], [78.08, 78.28, " самая"], [78.28, 78.78, " приятная"], [78.78, 78.96, " и"], [78.96, 79.46, " одновременно"]]}, {"start": 79.46, "end": 81.96, "text": "самая отрезвляющая – у вас появляется личный", "words": [[79.46, 79.74, " самая"], [79.74, 80.5, " отрезвляющая"], [80.5, 80.66, " –"], [80.66, 80.74, " у"], [80.74, 80.98, " вас"], [80.98, 81.54, " появляется"], [81.54, 81.96, " личный"]]}, {"start": 81.96, "end": 82.86, "text": "пенсионный фонд.", "words": [[81.96, 82.56, " пенсионный"], [82.56, 82.86, " фонд."]]}, {"start": 83.08, "end": 85.44, "text": "Давайте будем честны, пенсии в том виде, в котором", "words": [[83.08, 83.3, " Давайте"], [83.3, 83.56, " будем"], [83.56, 83.96, " честны,"], [84.12, 84.58, " пенсии"], [84.58, 84.7, " в"], [84.7, 84.8, " том"], [84.8, 85.04, " виде,"], [85.16, 85.26, " в"], [85.26, 85.44, " котором"]]}, {"start": 85.44, "end": 87.22, "text": "вы на нее рассчитываете, у вас не будет.", "words": [[85.44, 85.66, " вы"], [85.66, 85.68, " на"], [85.68, 85.86, " нее"], [85.86, 86.54, " рассчитываете,"], [86.6, 86.68, " у"], [86.68, 86.8, " вас"], [86.8, 87.0, " не"], [87.0, 87.22, " будет."]]}, {"start": 87.58, "end": 90.16, "text": "Демографическая структура общества меняется, работающих", "words": [[87.58, 88.08, " Демографическая"], [88.08, 88.56, " структура"], [88.56, 88.9, " общества"], [88.9, 89.46, " меняется,"], [89.6, 90.16, " работающих"]]}, {"start": 90.16, "end": 92.58, "text": "людей становится меньше, а пенсионеров больше.", "words": [[90.16, 90.4, " людей"], [90.4, 90.86, " становится"], [90.86, 91.32, " меньше,"], [91.5, 91.58, " а"], [91.58, 92.1, " пенсионеров"], [92.1, 92.58, " больше."]]}, {"start": 93.06, "end": 95.94, "text": "Солидарная система – это где молодые кормят старых,", "words": [[93.06, 93.6, " Солидарная"], [93.6, 94.08, " система"], [94.08, 94.34, " –"], [94.34, 94.46, " это"], [94.46, 94.78, " где"], [94.78, 95.2, " молодые"], [95.2, 95.56, " кормят"], [95.56, 95.94, " старых,"]]}, {"start": 96.14, "end": 96.96, "text": "трещит по швам.", "words": [[96.14, 96.46, " трещит"], [96.46, 96.62, " по"], [96.62, 96.96, " швам."]]}, {"start": 97.12, "end": 100.52, "text": "Правила игры, возраст, входа, коэффициенты, баллы и формулы", "words": [[97.12, 97.5, " Правила"], [97.5, 97.76, " игры,"], [98.2, 98.58, " возраст,"], [98.76, 99.04, " входа,"], [99.1, 99.64, " коэффициенты,"], [99.86, 100.02, " баллы"], [100.02, 100.1, " и"], [100.1, 100.52, " формулы"]]}, {"start": 100.52, "end": 102.06, "text": "меняются в процессе самой игры.", "words": [[100.52, 100.94, " меняются"], [100.94, 101.08, " в"], [101.08, 101.6, " процессе"], [101.6, 101.82, " самой"], [101.82, 102.06, " игры."]]}, {"start": 102.3, "end": 104.74, "text": "Рассчитывать на систему, которая вам абсолютно не", "words": [[102.3, 102.72, " Рассчитывать"], [102.72, 102.9, " на"], [102.9, 103.3, " систему,"], [103.56, 103.68, " которая"], [103.68, 104.06, " вам"], [104.06, 104.54, " абсолютно"], [104.54, 104.74, " не"]]}, {"start": 104.74, "end": 107.28, "text": "подконтрольна – это стратегическая ошибка.", "words": [[104.74, 105.52, " подконтрольна"], [105.52, 105.98, " –"], [105.98, 106.16, " это"], [106.16, 106.84, " стратегическая"], [106.84, 107.28, " ошибка."]]}, {"start": 107.44, "end": 110.14, "text": "В текущих условиях миллион рублей может давать вам", "words": [[107.44, 107.5, " В"], [107.5, 107.92, " текущих"], [107.92, 108.54, " условиях"], [108.54, 108.96, " миллион"], [108.96, 109.34, " рублей"], [109.34, 109.64, " может"], [109.64, 109.98, " давать"], [109.98, 110.14, " вам"]]}, {"start": 110.14, "end": 113.5, "text": "от 10 до 15 тысяч рублей в месяц до налогов, после", "words": [[110.14, 110.34, " от"], [110.34, 110.72, " 10"], [110.72, 110.9, " до"], [110.9, 111.42, " 15"], [111.42, 111.76, " тысяч"], [111.76, 112.06, " рублей"], [112.06, 112.22, " в"], [112.22, 112.54, " месяц"], [112.54, 112.72, " до"], [112.72, 113.2, " налогов,"], [113.3, 113.5, " после"]]}, {"start": 113.5, "end": 115.08, "text": "налогов зависит от инструментов.", "words": [[113.5, 114.0, " налогов"], [114.0, 114.28, " зависит"], [114.28, 114.44, " от"], [114.44, 115.08, " инструментов."]]}, {"start": 115.18, "end": 118.32, "text": "Просто вдумайтесь, средняя страховая пенсия в России", "words": [[115.18, 115.46, " Просто"], [115.46, 116.02, " вдумайтесь,"], [116.44, 116.86, " средняя"], [116.86, 117.46, " страховая"], [117.46, 117.84, " пенсия"], [117.84, 118.02, " в"], [118.02, 118.32, " России"]]}, {"start": 118.32, "end": 120.88, "text": "сегодня колеблется в районе 20 тысяч рублей.", "words": [[118.32, 118.76, " сегодня"], [118.76, 119.24, " колеблется"], [119.24, 119.42, " в"], [119.42, 119.66, " районе"], [119.66, 120.08, " 20"], [120.08, 120.42, " тысяч"], [120.42, 120.88, " рублей."]]}, {"start": 121.04, "end": 124.92, "text": "Чтобы ее заслужить, у вас должно быть 40 лет трудового", "words": [[121.04, 121.24, " Чтобы"], [121.24, 121.46, " ее"], [121.46, 122.0, " заслужить,"], [122.14, 122.18, " у"], [122.18, 122.38, " вас"], [122.38, 122.8, " должно"], [122.8, 123.26, " быть"], [123.26, 123.8, " 40"], [123.8, 124.28, " лет"], [124.28, 124.92, " трудового"]]}, {"start": 124.92, "end": 125.5, "text": "стажа.", "words": [[124.92, 125.5, " стажа."]]}, {"start": 125.54, "end": 129.4, "text": "Собрав свой первый миллион, вы уже на 70% обеспечили", "words": [[125.54, 126.02, " Собрав"], [126.02, 126.3, " свой"], [126.3, 126.66, " первый"], [126.66, 127.16, " миллион,"], [127.22, 127.4, " вы"], [127.4, 127.7, " уже"], [127.7, 127.86, " на"], [127.86, 128.26, " 70"], [128.26, 128.78, "%"], [128.78, 129.4, " обеспечили"]]}, {"start": 129.4, "end": 132.28, "text": "себе этот государственный уровень жизни в старости,", "words": [[129.4, 129.84, " себе"], [129.84, 130.3, " этот"], [130.3, 131.06, " государственный"], [131.06, 131.42, " уровень"], [131.42, 131.68, " жизни"], [131.68, 131.9, " в"], [131.9, 132.28, " старости,"]]}, {"start": 132.44, "end": 136.06, "text": "но сделали это сами, досрочно и на своих условиях.", "words": [[132.44, 132.72, " но"], [132.72, 133.04, " сделали"], [133.04, 133.38, " это"], [133.38, 133.82, " сами,"], [134.06, 134.68, " досрочно"], [134.68, 134.92, " и"], [134.92, 135.08, " на"], [135.08, 135.28, " своих"], [135.28, 136.06, " условиях."]]}, {"start": 136.16, "end": 138.4, "text": "Плюс, помимо самой доходности, у вас еще будет доступ", "words": [[136.16, 136.38, " Плюс,"], [136.52, 136.74, " помимо"], [136.74, 136.92, " самой"], [136.92, 137.38, " доходности,"], [137.46, 137.48, " у"], [137.48, 137.62, " вас"], [137.62, 137.84, " еще"], [137.84, 138.08, " будет"], [138.08, 138.4, " доступ"]]}, {"start": 138.4, "end": 140.8, "text": "к этому самому миллиону, которому вы в случае чего", "words": [[138.4, 138.6, " к"], [138.6, 138.76, " этому"], [138.76, 139.14, " самому"], [139.14, 139.7, " миллиону,"], [139.88, 140.04, " которому"], [140.04, 140.22, " вы"], [140.22, 140.24, " в"], [140.24, 140.56, " случае"], [140.56, 140.8, " чего"]]}, {"start": 140.8, "end": 142.88, "text": "сможете распорядиться по своему усмотрению.", "words": [[140.8, 141.2, " сможете"], [141.2, 141.76, " распорядиться"], [141.76, 142.02, " по"], [142.02, 142.26, " своему"], [142.26, 142.88, " усмотрению."]]}, {"start": 144.36, "end": 147.32, "text": "Вторая причина моя любимая – у вас появляется", "words": [[144.36, 144.68, " Вторая"], [144.68, 145.26, " причина"], [145.26, 145.5, " моя"], [145.5, 146.06, " любимая"], [146.06, 146.32, " –"], [146.32, 146.48, " у"], [146.48, 146.76, " вас"], [146.76, 147.32, " появляется"]]}, {"start": 147.32, "end": 150.66, "text": "тринадцатая зарплата, которую вам выплачивает ваш", "words": [[147.32, 148.08, " тринадцатая"], [148.08, 148.86, " зарплата,"], [149.22, 149.38, " которую"], [149.38, 149.62, " вам"], [149.62, 150.32, " выплачивает"], [150.32, 150.66, " ваш"]]}, {"start": 150.66, "end": 151.24, "text": "капитал.", "words": [[150.66, 151.24, " капитал."]]}, {"start": 151.34, "end": 154.64, "text": "В корпоративном мире тринадцатая зарплата – это своеобразная", "words": [[151.34, 151.46, " В"], [151.46, 152.06, " корпоративном"], [152.06, 152.44, " мире"], [152.44, 153.06, " тринадцатая"], [153.06, 153.62, " зарплата"], [153.62, 153.98, " –"], [153.98, 154.1, " это"], [154.1, 154.64, " своеобразная"]]}, {"start": 154.64, "end": 155.16, "text": "лотерия.", "words": [[154.64, 155.16, " лотерия."]]}, {"start": 155.36, "end": 158.14, "text": "Компания не выполнила план или банально ваш начальник", "words": [[155.36, 155.7, " Компания"], [155.7, 155.92, " не"], [155.92, 156.32, " выполнила"], [156.32, 156.64, " план"], [156.64, 157.08, " или"], [157.08, 157.54, " банально"], [157.54, 157.74, " ваш"], [157.74, 158.14, " начальник"]]}, {"start": 158.14, "end": 160.62, "text": "встал не с той ноги и плакал ваш годовой бонус.", "words": [[158.14, 158.38, " встал"], [158.38, 158.52, " не"], [158.52, 158.58, " с"], [158.58, 158.66, " той"], [158.66, 159.1, " ноги"], [159.1, 159.24, " и"], [159.24, 159.66, " плакал"], [159.66, 159.84, " ваш"], [159.84, 160.22, " годовой"], [160.22, 160.62, " бонус."]]}, {"start": 160.7, "end": 162.6, "text": "Когда у вас есть миллион, правила меняются.", "words": [[160.7, 160.9, " Когда"], [160.9, 160.98, " у"], [160.98, 161.12, " вас"], [161.12, 161.34, " есть"], [161.34, 161.7, " миллион,"], [161.96, 162.08, " правила"], [162.08, 162.6, " меняются."]]}, {"start": 162.72, "end": 166.38, "text": "При доходности 15% годовых ваш миллион приносит", "words": [[162.72, 163.0, " При"], [163.0, 163.74, " доходности"], [163.74, 164.16, " 15"], [164.16, 164.6, "%"], [164.6, 165.3, " годовых"], [165.3, 165.54, " ваш"], [165.54, 165.96, " миллион"], [165.96, 166.38, " приносит"]]}, {"start": 166.38, "end": 167.96, "text": "150 тысяч рублей в год.", "words": [[166.38, 166.88, " 150"], [166.88, 167.26, " тысяч"], [167.26, 167.62, " рублей"], [167.62, 167.8, " в"], [167.8, 167.96, " год."]]}, {"start": 168.1, "end": 171.3, "text": "Если вы зарабатываете, скажем, 80 или 100 тысяч рублей", "words": [[168.1, 168.34, " Если"], [168.34, 168.52, " вы"], [168.52, 169.14, " зарабатываете,"], [169.14, 169.54, " скажем,"], [169.72, 170.12, " 80"], [170.12, 170.4, " или"], [170.4, 170.72, " 100"], [170.72, 171.0, " тысяч"], [171.0, 171.3, " рублей"]]}, {"start": 171.3, "end": 174.12, "text": "в месяц, то этот доход от капитала – это и есть", "words": [[171.3, 171.44, " в"], [171.44, 171.8, " месяц,"], [172.0, 172.16, " то"], [172.16, 172.4, " этот"], [172.4, 172.68, " доход"], [172.68, 172.82, " от"], [172.82, 173.42, " капитала"], [173.42, 173.82, " –"], [173.82, 173.82, " это"], [173.82, 173.92, " и"], [173.92, 174.12, " есть"]]}, {"start": 174.12, "end": 177.88, "text": "ваша полноценная тринадцатая, а то и четырнадцатая зарплата.", "words": [[174.12, 174.38, " ваша"], [174.38, 175.18, " полноценная"], [175.18, 176.24, " тринадцатая,"], [176.34, 176.52, " а"], [176.52, 176.68, " то"], [176.68, 176.9, " и"], [176.9, 177.42, " четырнадцатая"], [177.42, 177.88, " зарплата."]]}, {"start": 179.54, "end": 182.6, "text": "И вот тут мы переходим к третьей, пожалуй, самой", "words": [[179.54, 179.68, " И"], [179.68, 179.9, " вот"], [179.9, 180.06, " тут"], [180.06, 180.4, " мы"], [180.4, 180.82, " переходим"], [180.82, 180.94, " к"], [180.94, 181.48, " третьей,"], [181.54, 181.98, " пожалуй,"], [182.26, 182.6, " самой"]]}, {"start": 182.6, "end": 185.62, "text": "стратегически важной причине накопить тут самый миллион.", "words": [[182.6, 183.42, " стратегически"], [183.42, 183.8, " важной"], [183.8, 184.32, " причине"], [184.32, 184.82, " накопить"], [184.82, 185.0, " тут"], [185.0, 185.18, " самый"], [185.18, 185.62, " миллион."]]}, {"start": 185.78, "end": 188.18, "text": "Третья причина – это так называемая готовность.", "words": [[185.78, 186.06, " Третья"], [186.06, 186.62, " причина"], [186.62, 186.8, " –"], [186.8, 186.84, " это"], [186.84, 187.02, " так"], [187.02, 187.58, " называемая"], [187.58, 188.18, " готовность."]]}, {"start": 188.42, "end": 190.52, "text": "Знаете, в чем, как мне кажется, главная трагедия", "words": [[188.42, 188.76, " Знаете,"], [188.88, 188.9, " в"], [188.9, 189.06, " чем,"], [189.2, 189.36, " как"], [189.36, 189.48, " мне"], [189.48, 189.72, " кажется,"], [190.02, 190.14, " главная"], [190.14, 190.52, " трагедия"]]}, {"start": 190.52, "end": 192.58, "text": "большинства людей, которые ничего не достигли?", "words": [[190.52, 191.02, " большинства"], [191.02, 191.3, " людей,"], [191.52, 191.72, " которые"], [191.72, 191.98, " ничего"], [191.98, 192.24, " не"], [192.24, 192.58, " достигли?"]]}, {"start": 192.76, "end": 195.82, "text": "Они видят отличные возможности, но просто не могут ими", "words": [[192.76, 193.02, " Они"], [193.02, 193.46, " видят"], [193.46, 193.9, " отличные"], [193.9, 194.5, " возможности,"], [194.58, 194.88, " но"], [194.88, 195.18, " просто"], [195.18, 195.36, " не"], [195.36, 195.56, " могут"], [195.56, 195.82, " ими"]]}, {"start": 195.82, "end": 196.48, "text": "воспользоваться.", "words": [[195.82, 196.48, " воспользоваться."]]}, {"start": 196.86, "end": 199.24, "text": "Есть такая формула, которую я не помню уже где", "words": [[196.86, 197.2, " Есть"], [197.2, 197.48, " такая"], [197.48, 198.02, " формула,"], [198.24, 198.4, " которую"], [198.4, 198.58, " я"], [198.58, 198.72, " не"], [198.72, 198.92, " помню"], [198.92, 199.06, " уже"], [199.06, 199.24, " где"]]}, {"start": 199.24, "end": 199.66, "text": "увидел.", "words": [[199.24, 199.66, " увидел."]]}, {"start": 199.76, "end": 203.32, "text": "Успех в новом начинании – это всегда возможность", "words": [[199.76, 200.22, " Успех"], [200.22, 200.4, " в"], [200.4, 200.68, " новом"], [200.68, 201.3, " начинании"], [201.3, 201.5, " –"], [201.5, 201.82, " это"], [201.82, 202.36, " всегда"], [202.36, 203.32, " возможность"]]}, {"start": 203.32, "end": 204.56, "text": "плюс готовность.", "words": [[203.32, 203.78, " плюс"], [203.78, 204.56, " готовность."]]}, {"start": 204.7, "end": 207.6, "text": "Рассказы про то, что возможности выпадают лишь избранным", "words": [[204.7, 205.2, " Рассказы"], [205.2, 205.34, " про"], [205.34, 205.46, " то,"], [205.64, 205.8, " что"], [205.8, 206.32, " возможности"], [206.32, 206.76, " выпадают"], [206.76, 207.0, " лишь"], [207.0, 207.6, " избранным"]]}, {"start": 207.6, "end": 208.48, "text": "– это буллщит.", "words": [[207.6, 207.86, " –"], [207.86, 208.0, " это"], [208.0, 208.48, " буллщит."]]}, {"start": 208.64, "end": 211.34, "text": "У каждого человека в жизни бывают несколько моментов,", "words": [[208.64, 208.84, " У"], [208.84, 209.16, " каждого"], [209.16, 209.5, " человека"], [209.5, 209.64, " в"], [209.64, 209.84, " жизни"], [209.84, 210.22, " бывают"], [210.22, 210.62, " несколько"], [210.62, 211.34, " моментов,"]]}, {"start": 211.38, "end": 214.6, "text": "когда можно в корне изменить свою финансовую ситуацию.", "words": [[211.38, 211.7, " когда"], [211.7, 212.14, " можно"], [212.14, 212.36, " в"], [212.36, 212.66, " корне"], [212.66, 213.08, " изменить"], [213.08, 213.3, " свою"], [213.3, 213.92, " финансовую"], [213.92, 214.6, " ситуацию."]]}, {"start": 214.74, "end": 217.66, "text": "Но проблема в том, что у любой такой возможности", "words": [[214.74, 215.08, " Но"], [215.08, 215.48, " проблема"], [215.48, 215.66, " в"], [215.66, 215.88, " том,"], [216.12, 216.3, " что"], [216.3, 216.5, " у"], [216.5, 216.68, " любой"], [216.68, 216.92, " такой"], [216.92, 217.66, " возможности"]]}, {"start": 217.66, "end": 220.7, "text": "чрезвычайно короткий, в кавычках, срок годности.", "words": [[217.66, 218.48, " чрезвычайно"], [218.48, 219.04, " короткий,"], [219.04, 219.26, " в"], [219.26, 219.72, " кавычках,"], [219.92, 220.14, " срок"], [220.14, 220.7, " годности."]]}, {"start": 220.96, "end": 223.32, "text": "Она не будет ждать полгода, пока вы накопите на условный", "words": [[220.96, 220.96, " Она"], [220.96, 221.14, " не"], [221.14, 221.32, " будет"], [221.32, 221.64, " ждать"], [221.64, 222.06, " полгода,"], [222.1, 222.26, " пока"], [222.26, 222.44, " вы"], [222.44, 222.82, " накопите"], [222.82, 222.94, " на"], [222.94, 223.32, " условный"]]}, {"start": 223.32, "end": 226.18, "text": "первый взнос или создадите подушку, действовать нужно", "words": [[223.32, 223.58, " первый"], [223.58, 223.94, " взнос"], [223.94, 224.22, " или"], [224.22, 224.7, " создадите"], [224.7, 225.26, " подушку,"], [225.46, 225.88, " действовать"], [225.88, 226.18, " нужно"]]}, {"start": 226.18, "end": 227.34, "text": "будет здесь и сейчас.", "words": [[226.18, 226.44, " будет"], [226.44, 226.78, " здесь"], [226.78, 226.98, " и"], [226.98, 227.34, " сейчас."]]}, {"start": 227.66, "end": 231.12, "text": "Я не буду трогать психологическую сторону готовности,", "words": [[227.66, 227.92, " Я"], [227.92, 228.1, " не"], [228.1, 228.3, " буду"], [228.3, 228.92, " трогать"], [228.92, 229.78, " психологическую"], [229.78, 230.18, " сторону"], [230.18, 231.12, " готовности,"]]}, {"start": 231.28, "end": 232.66, "text": "про это вам расскажут психологи.", "words": [[231.28, 231.42, " про"], [231.42, 231.54, " это"], [231.54, 231.72, " вам"], [231.72, 232.08, " расскажут"], [232.08, 232.66, " психологи."]]}, {"start": 232.66, "end": 235.42, "text": "Я вот говорю чисто про финансовую сторону вопроса.", "words": [[232.66, 232.98, " Я"], [232.98, 233.16, " вот"], [233.16, 233.34, " говорю"], [233.34, 233.74, " чисто"], [233.74, 233.86, " про"], [233.86, 234.46, " финансовую"], [234.46, 234.7, " сторону"], [234.7, 235.42, " вопроса."]]}, {"start": 235.58, "end": 237.92, "text": "Вы хотите уйти с работы в свой бизнес, или может", "words": [[235.58, 235.6, " Вы"], [235.6, 235.88, " хотите"], [235.88, 236.2, " уйти"], [236.2, 236.34, " с"], [236.34, 236.62, " работы"], [236.62, 236.78, " в"], [236.78, 236.88, " свой"], [236.88, 237.32, " бизнес,"], [237.74, 237.78, " или"], [237.78, 237.92, " может"]]}, {"start": 237.92, "end": 240.62, "text": "быть хотите сменить профессию и полгода учиться, не думая", "words": [[237.92, 238.4, " быть"], [238.4, 238.4, " хотите"], [238.4, 238.72, " сменить"], [238.72, 239.32, " профессию"], [239.32, 239.46, " и"], [239.46, 239.78, " полгода"], [239.78, 240.2, " учиться,"], [240.3, 240.36, " не"], [240.36, 240.62, " думая"]]}, {"start": 240.62, "end": 241.34, "text": "о подработках.", "words": [[240.62, 240.7, " о"], [240.7, 241.34, " подработках."]]}, {"start": 241.6, "end": 243.62, "text": "А может быть там вы хотите переехать в другой город", "words": [[241.6, 241.68, " А"], [241.68, 241.8, " может"], [241.8, 241.96, " быть"], [241.96, 242.1, " там"], [242.1, 242.24, " вы"], [242.24, 242.56, " хотите"], [242.56, 243.02, " переехать"], [243.02, 243.18, " в"], [243.18, 243.34, " другой"], [243.34, 243.62, " город"]]}, {"start": 243.62, "end": 246.66, "text": "или страну, потому что видите в этом некие перспективы.", "words": [[243.62, 243.88, " или"], [243.88, 244.24, " страну,"], [244.42, 244.52, " потому"], [244.52, 244.82, " что"], [244.82, 245.18, " видите"], [245.18, 245.26, " в"], [245.26, 245.64, " этом"], [245.64, 245.96, " некие"], [245.96, 246.66, " перспективы."]]}, {"start": 246.9, "end": 248.26, "text": "Любой такой маневр – это всегда.", "words": [[246.9, 247.1, " Любой"], [247.1, 247.3, " такой"], [247.3, 247.88, " маневр"], [247.88, 248.08, " –"], [248.08, 248.16, " это"], [248.16, 248.26, " всегда."]]}]