[{"start": 0.0, "end": 4.52, "text": "до зарплаты, как перехватить до зарплаты или как закрыть финансовую дыру. Психологический", "words": [[0.0, 0.22, " до"], [0.22, 0.7, " зарплаты,"], [0.72, 0.88, " как"], [0.88, 1.52, " перехватить"], [1.52, 1.66, " до"], [1.66, 2.26, " зарплаты"], [2.26, 2.48, " или"], [2.48, 2.7, " как"], [2.7, 2.96, " закрыть"], [2.96, 3.38, " финансовую"], [3.38, 3.8, " дыру."], [3.98, 4.52, " Психологический"]]}, {"start": 4.52, "end": 9.16, "text": "комфорт от семизначной суммы на счету дает вам самое главное преимущество в капиталистическом", "words": [[4.52, 5.0, " комфорт"], [5.0, 5.16, " от"], [5.16, 5.68, " семизначной"], [5.68, 5.96, " суммы"], [5.96, 6.1, " на"], [6.1, 6.3, " счету"], [6.3, 6.56, " дает"], [6.56, 6.94, " вам"], [6.94, 7.2, " самое"], [7.2, 7.54, " главное"], [7.54, 8.24, " преимущество"], [8.24, 8.34, " в"], [8.34, 9.16, " капиталистическом"]]}, {"start": 9.16, "end": 13.42, "text": "мире — это трезвый рассудок. Вы перестаете совершать импульсивные ошибки на панике,", "words": [[9.16, 9.48, " мире"], [9.48, 9.82, " —"], [9.82, 9.9, " это"], [9.9, 10.2, " трезвый"], [10.2, 10.76, " рассудок."], [10.8, 11.06, " Вы"], [11.06, 11.46, " перестаете"], [11.46, 11.9, " совершать"], [11.9, 12.48, " импульсивные"], [12.48, 12.84, " ошибки"], [12.84, 13.02, " на"], [13.02, 13.42, " панике,"]]}, {"start": 13.64, "end": 20.38, "text": "которые обычно и стоят людям больших денег. Когда ваш мозг очищается от вот этого тумана", "words": [[13.64, 13.84, " которые"], [13.84, 14.4, " обычно"], [14.4, 14.7, " и"], [14.7, 14.86, " стоят"], [14.86, 15.16, " людям"], [15.16, 15.76, " больших"], [15.76, 16.06, " денег."], [17.4, 17.78, " Когда"], [17.78, 18.12, " ваш"], [18.12, 18.56, " мозг"], [18.56, 19.26, " очищается"], [19.26, 19.46, " от"], [19.46, 19.82, " вот"], [19.82, 19.82, " этого"], [19.82, 20.38, " тумана"]]}, {"start": 20.38, "end": 25.52, "text": "девцитного мышления, о котором мы говорили в прошлом пункте, происходит еще одна удивительная", "words": [[20.38, 20.94, " девцитного"], [20.94, 21.44, " мышления,"], [21.88, 21.96, " о"], [21.96, 22.14, " котором"], [22.14, 22.36, " мы"], [22.36, 22.62, " говорили"], [22.62, 22.8, " в"], [22.8, 23.08, " прошлом"], [23.08, 23.46, " пункте,"], [23.64, 24.0, " происходит"], [24.0, 24.6, " еще"], [24.6, 24.88, " одна"], [24.88, 25.52, " удивительная"]]}, {"start": 26.04, "end": 30.94, "text": "метаморфоза. Шестая причина — это конец эпохи дешевых понтов в вашей жизни. Знаете, кто чаще", "words": [[26.04, 26.52, " метаморфоза."], [26.52, 26.94, " Шестая"], [26.94, 27.48, " причина"], [27.48, 27.84, " —"], [27.84, 27.98, " это"], [27.98, 28.22, " конец"], [28.22, 28.52, " эпохи"], [28.52, 28.92, " дешевых"], [28.92, 29.24, " понтов"], [29.24, 29.44, " в"], [29.44, 29.6, " вашей"], [29.6, 29.9, " жизни."], [30.1, 30.38, " Знаете,"], [30.46, 30.62, " кто"], [30.62, 30.94, " чаще"]]}, {"start": 30.94, "end": 35.34, "text": "всего покупает последний айфон в кредит на три года или берет подержанный премиум автомобиль,", "words": [[30.94, 31.14, " всего"], [31.14, 31.6, " покупает"], [31.6, 32.02, " последний"], [32.02, 32.3, " айфон"], [32.3, 32.46, " в"], [32.46, 32.72, " кредит"], [32.72, 32.84, " на"], [32.84, 33.04, " три"], [33.04, 33.28, " года"], [33.28, 33.64, " или"], [33.64, 33.94, " берет"], [33.94, 34.46, " подержанный"], [34.46, 34.88, " премиум"], [34.88, 35.34, " автомобиль,"]]}, {"start": 35.5, "end": 39.92, "text": "который не на что обслуживать? В основном это люди, у которых денег в общем-то нету. И это не", "words": [[35.5, 35.68, " который"], [35.68, 35.86, " не"], [35.86, 35.9, " на"], [35.9, 36.04, " что"], [36.04, 36.6, " обслуживать?"], [36.84, 36.92, " В"], [36.92, 37.12, " основном"], [37.12, 37.26, " это"], [37.26, 37.46, " люди,"], [37.54, 37.62, " у"], [37.62, 38.12, " которых"], [38.12, 38.52, " денег"], [38.52, 38.76, " в"], [38.76, 39.0, " общем"], [39.0, 39.22, "-то"], [39.22, 39.58, " нету."], [39.64, 39.76, " И"], [39.76, 39.84, " это"], [39.84, 39.92, " не"]]}, {"start": 39.92, "end": 44.52, "text": "потому что они глупые, это банальная попытка купить себе социальное уважение, которого им", "words": [[39.92, 40.12, " потому"], [40.12, 40.26, " что"], [40.26, 40.44, " они"], [40.44, 40.92, " глупые,"], [41.08, 41.46, " это"], [41.46, 41.86, " банальная"], [41.86, 42.24, " попытка"], [42.24, 42.54, " купить"], [42.54, 42.74, " себе"], [42.74, 43.24, " социальное"], [43.24, 43.8, " уважение,"], [43.98, 44.18, " которого"], [44.18, 44.52, " им"]]}, {"start": 44.52, "end": 49.04, "text": "не хватает из-за финансовой или еще какой-то неуверенности. Когда у тебя на счету ноль,", "words": [[44.52, 44.74, " не"], [44.74, 45.26, " хватает"], [45.26, 45.52, " из"], [45.52, 45.68, "-за"], [45.68, 46.3, " финансовой"], [46.3, 46.52, " или"], [46.52, 46.72, " еще"], [46.72, 46.82, " какой"], [46.82, 46.96, "-то"], [46.96, 47.6, " неуверенности."], [47.7, 48.0, " Когда"], [48.0, 48.1, " у"], [48.1, 48.3, " тебя"], [48.3, 48.44, " на"], [48.44, 48.72, " счету"], [48.72, 49.04, " ноль,"]]}, {"start": 49.12, "end": 54.34, "text": "ты чувствуешь себя голым. Ты пытаешься прикрыться брендами, логотипами и статусными", "words": [[49.12, 49.46, " ты"], [49.46, 49.86, " чувствуешь"], [49.86, 50.44, " себя"], [50.44, 50.96, " голым."], [51.08, 51.28, " Ты"], [51.28, 51.8, " пытаешься"], [51.8, 52.18, " прикрыться"], [52.18, 52.84, " брендами,"], [52.98, 53.62, " логотипами"], [53.62, 53.92, " и"], [53.92, 54.34, " статусными"]]}, {"start": 54.34, "end": 58.52, "text": "атрибутами. Тут мир не догадался, насколько ты уязвим в этом плане. Первый миллион полностью", "words": [[54.34, 55.02, " атрибутами."], [55.14, 55.2, " Тут"], [55.2, 55.32, " мир"], [55.32, 55.5, " не"], [55.5, 55.84, " догадался,"], [56.04, 56.2, " насколько"], [56.2, 56.42, " ты"], [56.42, 56.74, " уязвим"], [56.74, 56.88, " в"], [56.88, 57.06, " этом"], [57.06, 57.4, " плане."], [57.5, 57.74, " Первый"], [57.74, 58.08, " миллион"], [58.08, 58.52, " полностью"]]}, {"start": 58.52, "end": 63.4, "text": "отключает эту потребность. Когда вы знаете, что у вас в кармане или на брокерском счете лежит", "words": [[58.52, 59.02, " отключает"], [59.02, 59.18, " эту"], [59.18, 59.68, " потребность."], [59.76, 59.9, " Когда"], [59.9, 60.04, " вы"], [60.04, 60.3, " знаете,"], [60.48, 60.58, " что"], [60.58, 60.66, " у"], [60.66, 60.88, " вас"], [60.88, 60.96, " в"], [60.96, 61.6, " кармане"], [61.6, 61.96, " или"], [61.96, 62.2, " на"], [62.2, 62.66, " брокерском"], [62.66, 63.06, " счете"], [63.06, 63.4, " лежит"]]}, {"start": 63.4, "end": 67.76, "text": "7 цифр, которые могут лишить любую вашу проблему, вам становится абсолютно все равно,", "words": [[63.4, 63.6, " 7"], [63.6, 64.1, " цифр,"], [64.28, 64.44, " которые"], [64.44, 64.7, " могут"], [64.7, 65.04, " лишить"], [65.04, 65.28, " любую"], [65.28, 65.6, " вашу"], [65.6, 66.0, " проблему,"], [66.12, 66.28, " вам"], [66.28, 66.64, " становится"], [66.64, 67.26, " абсолютно"], [67.26, 67.44, " все"], [67.44, 67.76, " равно,"]]}, {"start": 68.04, "end": 72.3, "text": "что о вас подумает Борис-то в кофейне или коллега по работе. Более того, ваша уверенность", "words": [[68.04, 68.16, " что"], [68.16, 68.18, " о"], [68.18, 68.36, " вас"], [68.36, 68.74, " подумает"], [68.74, 69.08, " Борис"], [69.08, 69.14, "-то"], [69.14, 69.24, " в"], [69.24, 69.74, " кофейне"], [69.74, 69.98, " или"], [69.98, 70.3, " коллега"], [70.3, 70.48, " по"], [70.48, 70.84, " работе."], [70.98, 71.24, " Более"], [71.24, 71.5, " того,"], [71.7, 71.8, " ваша"], [71.8, 72.3, " уверенность"]]}, {"start": 72.3, "end": 76.28, "text": "взлетает до небес, когда вы понимаете, что, ну, словно и коллега с новым айфоном будет", "words": [[72.3, 72.74, " взлетает"], [72.74, 72.9, " до"], [72.9, 73.2, " небес,"], [73.24, 73.38, " когда"], [73.38, 73.58, " вы"], [73.58, 73.96, " понимаете,"], [74.38, 74.58, " что,"], [74.7, 74.74, " ну,"], [74.74, 74.98, " словно"], [74.98, 75.06, " и"], [75.06, 75.32, " коллега"], [75.32, 75.44, " с"], [75.44, 75.64, " новым"], [75.64, 76.02, " айфоном"], [76.02, 76.28, " будет"]]}, {"start": 76.28, "end": 80.98, "text": "три года отдавать за него часть зарплаты, а вы можете прямо сейчас пойти и купить себе таких", "words": [[76.28, 76.52, " три"], [76.52, 76.72, " года"], [76.72, 77.08, " отдавать"], [77.08, 77.16, " за"], [77.16, 77.36, " него"], [77.36, 77.56, " часть"], [77.56, 78.2, " зарплаты,"], [78.26, 78.4, " а"], [78.4, 78.5, " вы"], [78.5, 78.8, " можете"], [78.8, 79.06, " прямо"], [79.06, 79.4, " сейчас"], [79.4, 79.92, " пойти"], [79.92, 80.16, " и"], [80.16, 80.46, " купить"], [80.46, 80.68, " себе"], [80.68, 80.98, " таких"]]}, {"start": 80.98, "end": 86.18, "text": "10 штук. Но никогда этого не сделаете, потому что этот капитал может давать вам тот самый новый", "words": [[80.98, 81.32, " 10"], [81.32, 81.92, " штук."], [82.02, 82.08, " Но"], [82.08, 82.42, " никогда"], [82.42, 82.6, " этого"], [82.6, 82.86, " не"], [82.86, 83.2, " сделаете,"], [83.4, 83.54, " потому"], [83.54, 84.0, " что"], [84.0, 84.2, " этот"], [84.2, 84.54, " капитал"], [84.54, 84.78, " может"], [84.78, 85.12, " давать"], [85.12, 85.44, " вам"], [85.44, 85.58, " тот"], [85.58, 85.98, " самый"], [85.98, 86.18, " новый"]]}, {"start": 86.18, "end": 90.4, "text": "айфон ежегодно. Я, если что, никого не призываю покупать айфоны на доходы с капитала,", "words": [[86.18, 86.64, " айфон"], [86.64, 87.4, " ежегодно."], [87.64, 87.72, " Я,"], [87.78, 87.92, " если"], [87.92, 88.06, " что,"], [88.14, 88.32, " никого"], [88.32, 88.48, " не"], [88.48, 88.76, " призываю"], [88.76, 89.1, " покупать"], [89.1, 89.46, " айфоны"], [89.46, 89.6, " на"], [89.6, 89.92, " доходы"], [89.92, 90.0, " с"], [90.0, 90.4, " капитала,"]]}, {"start": 90.5, "end": 93.72, "text": "но иногда приятно подумать о том, что у вас есть такая возможность. В общем,", "words": [[90.5, 90.7, " но"], [90.7, 91.04, " иногда"], [91.04, 91.38, " приятно"], [91.38, 91.74, " подумать"], [91.74, 91.84, " о"], [91.84, 91.96, " том,"], [92.04, 92.1, " что"], [92.1, 92.16, " у"], [92.16, 92.28, " вас"], [92.28, 92.46, " есть"], [92.46, 92.66, " такая"], [92.66, 93.18, " возможность."], [93.42, 93.56, " В"], [93.56, 93.72, " общем,"]]}, {"start": 93.82, "end": 98.34, "text": "с миллионом вам больше не нужно доказывать свою состоятельность через вещи. Вы спокойно ходите", "words": [[93.82, 93.88, " с"], [93.88, 94.36, " миллионом"], [94.36, 94.6, " вам"], [94.6, 94.94, " больше"], [94.94, 95.14, " не"], [95.14, 95.3, " нужно"], [95.3, 95.78, " доказывать"], [95.78, 95.96, " свою"], [95.96, 96.56, " состоятельность"], [96.56, 96.84, " через"], [96.84, 97.12, " вещи."], [97.36, 97.6, " Вы"], [97.6, 98.04, " спокойно"], [98.04, 98.34, " ходите"]]}, {"start": 98.34, "end": 103.36, "text": "в базовые футболки за 500 рублей, потому что ваша уверенность растет не из этикетки на спине,", "words": [[98.34, 98.48, " в"], [98.48, 98.76, " базовые"], [98.76, 99.16, " футболки"], [99.16, 99.32, " за"], [99.32, 99.54, " 500"], [99.54, 99.88, " рублей,"], [100.02, 100.2, " потому"], [100.2, 100.4, " что"], [100.4, 100.6, " ваша"], [100.6, 101.08, " уверенность"], [101.08, 101.58, " растет"], [101.58, 102.04, " не"], [102.04, 102.48, " из"], [102.48, 102.92, " этикетки"], [102.92, 103.06, " на"], [103.06, 103.36, " спине,"]]}, {"start": 103.5, "end": 107.36, "text": "а из осознания своей финансовой прочности и роста капитала. И вы начинаете ценить", "words": [[103.5, 103.62, " а"], [103.62, 103.74, " из"], [103.74, 104.24, " осознания"], [104.24, 104.44, " своей"], [104.44, 104.96, " финансовой"], [104.96, 105.48, " прочности"], [105.48, 105.58, " и"], [105.58, 105.78, " роста"], [105.78, 106.3, " капитала."], [106.38, 106.5, " И"], [106.5, 106.66, " вы"], [106.66, 107.02, " начинаете"], [107.02, 107.36, " ценить"]]}, {"start": 107.36, "end": 111.42, "text": "функциональность вещей выше их статуса. Возможно, в вашей жизни даже появится", "words": [[107.36, 108.2, " функциональность"], [108.2, 108.64, " вещей"], [108.64, 108.9, " выше"], [108.9, 109.18, " их"], [109.18, 109.7, " статуса."], [109.82, 110.18, " Возможно,"], [110.34, 110.34, " в"], [110.34, 110.52, " вашей"], [110.52, 110.76, " жизни"], [110.76, 111.0, " даже"], [111.0, 111.42, " появится"]]}, {"start": 111.42, "end": 115.2, "text": "термин «цена за носку» в контексте покупки вещей. Это очень полезная штука.", "words": [[111.42, 111.9, " термин"], [111.9, 112.22, " «цена"], [112.22, 112.38, " за"], [112.38, 112.86, " носку»"], [112.86, 112.98, " в"], [112.98, 113.3, " контексте"], [113.3, 113.64, " покупки"], [113.64, 114.04, " вещей."], [114.16, 114.3, " Это"], [114.3, 114.46, " очень"], [114.46, 114.8, " полезная"], [114.8, 115.2, " штука."]]}, {"start": 115.4, "end": 120.86, "text": "Как ни странно, именно после накопления первой серьезной суммы люди часто начинают тратить на", "words": [[115.4, 115.58, " Как"], [115.58, 115.78, " ни"], [115.78, 116.32, " странно,"], [116.54, 116.68, " именно"], [116.68, 117.12, " после"], [117.12, 117.72, " накопления"], [117.72, 118.14, " первой"], [118.14, 118.62, " серьезной"], [118.62, 119.14, " суммы"], [119.14, 119.44, " люди"], [119.44, 119.76, " часто"], [119.76, 120.26, " начинают"], [120.26, 120.66, " тратить"], [120.66, 120.86, " на"]]}, {"start": 120.86, "end": 125.7, "text": "потребление меньше, чем когда они были бедными. Вы выходите из вот этих так называемых кресиных", "words": [[120.86, 121.48, " потребление"], [121.48, 121.9, " меньше,"], [122.12, 122.24, " чем"], [122.24, 122.46, " когда"], [122.46, 122.62, " они"], [122.62, 122.84, " были"], [122.84, 123.24, " бедными."], [123.36, 123.56, " Вы"], [123.56, 124.02, " выходите"], [124.02, 124.24, " из"], [124.24, 124.28, " вот"], [124.28, 124.48, " этих"], [124.48, 124.72, " так"], [124.72, 125.28, " называемых"], [125.28, 125.7, " кресиных"]]}, {"start": 125.7, "end": 130.96, "text": "бегов за престижем и начинаете просто играть в свою игру. Окей, идем дальше. Мы", "words": [[125.7, 126.02, " бегов"], [126.02, 126.2, " за"], [126.2, 126.74, " престижем"], [126.74, 126.94, " и"], [126.94, 127.32, " начинаете"], [127.32, 127.62, " просто"], [127.62, 127.88, " играть"], [127.88, 128.08, " в"], [128.08, 128.22, " свою"], [128.22, 128.58, " игру."], [129.42, 129.86, " Окей,"], [129.98, 130.16, " идем"], [130.16, 130.52, " дальше."], [130.74, 130.96, " Мы"]]}, {"start": 130.96, "end": 136.16, "text": "разобрались. Миллион дает нам некую свободу… быть, а не казаться. Но давайте будем,", "words": [[130.96, 131.54, " разобрались."], [131.74, 132.06, " Миллион"], [132.06, 132.3, " дает"], [132.3, 132.5, " нам"], [132.5, 132.84, " некую"], [132.84, 133.92, " свободу…"], [133.92, 134.44, " быть,"], [134.62, 134.68, " а"], [134.68, 134.8, " не"], [134.8, 135.22, " казаться."], [135.44, 135.62, " Но"], [135.62, 135.9, " давайте"], [135.9, 136.16, " будем,"]]}, {"start": 136.16, "end": 141.58, "text": "предельно честным. Большинство людей бросают копить на полпути или в самом начале по одной", "words": [[136.16, 136.9, " предельно"], [136.9, 137.4, " честным."], [137.42, 137.94, " Большинство"], [137.94, 138.3, " людей"], [138.3, 138.86, " бросают"], [138.86, 139.34, " копить"], [139.34, 139.54, " на"], [139.54, 140.22, " полпути"], [140.22, 140.44, " или"], [140.44, 140.6, " в"], [140.6, 140.68, " самом"], [140.68, 141.16, " начале"], [141.16, 141.44, " по"], [141.44, 141.58, " одной"]]}, {"start": 141.58, "end": 146.92, "text": "простой причине. Инвестировать маленькие суммы – это смертельно скучно. Когда ты", "words": [[141.58, 141.92, " простой"], [141.92, 142.46, " причине."], [142.78, 143.46, " Инвестировать"], [143.46, 144.02, " маленькие"], [144.02, 144.54, " суммы"], [144.54, 144.84, " –"], [144.84, 145.02, " это"], [145.02, 145.66, " смертельно"], [145.66, 146.14, " скучно."], [146.5, 146.72, " Когда"], [146.72, 146.92, " ты"]]}, {"start": 146.92, "end": 151.68, "text": "откладываешь по 5 или 10 тысяч рублей в месяц и видишь в конце квартала доходность в пару", "words": [[146.92, 147.44, " откладываешь"], [147.44, 147.66, " по"], [147.66, 147.96, " 5"], [147.96, 148.14, " или"], [148.14, 148.52, " 10"], [148.52, 148.92, " тысяч"], [148.92, 149.22, " рублей"], [149.22, 149.38, " в"], [149.38, 149.74, " месяц"], [149.74, 149.82, " и"], [149.82, 150.08, " видишь"], [150.08, 150.14, " в"], [150.14, 150.4, " конце"], [150.4, 150.88, " квартала"], [150.88, 151.34, " доходность"], [151.34, 151.54, " в"], [151.54, 151.68, " пару"]]}, {"start": 151.68, "end": 157.6, "text": "тысяч, мотивации это естественно не прибавляет. И это нормально, до миллиона рублей инвестиции", "words": [[151.68, 152.3, " тысяч,"], [152.72, 153.18, " мотивации"], [153.18, 153.42, " это"], [153.42, 153.84, " естественно"], [153.84, 154.1, " не"], [154.1, 154.66, " прибавляет."], [155.02, 155.14, " И"], [155.14, 155.28, " это"], [155.28, 155.72, " нормально,"], [155.96, 156.0, " до"], [156.0, 156.4, " миллиона"], [156.4, 157.0, " рублей"], [157.0, 157.6, " инвестиции"]]}, {"start": 157.6, "end": 163.32, "text": "больше похоже на какую-то бесперспективную нудятину. И здесь мы подходим к седьмой причине,", "words": [[157.6, 157.94, " больше"], [157.94, 158.24, " похоже"], [158.24, 158.48, " на"], [158.48, 158.62, " какую"], [158.62, 158.88, "-то"], [158.88, 159.78, " бесперспективную"], [159.78, 160.34, " нудятину."], [160.64, 160.92, " И"], [160.92, 161.5, " здесь"], [161.5, 161.94, " мы"], [161.94, 162.38, " подходим"], [162.38, 162.5, " к"], [162.5, 162.78, " седьмой"], [162.78, 163.32, " причине,"]]}, {"start": 163.32, "end": 169.24, "text": "точка в которой скучное накопление превращается в некую захватывающую стратегическую нру. Мы", "words": [[163.32, 163.82, " точка"], [163.82, 164.0, " в"], [164.0, 164.28, " которой"], [164.28, 164.8, " скучное"], [164.8, 165.32, " накопление"], [165.32, 166.26, " превращается"], [166.26, 166.48, " в"], [166.48, 166.68, " некую"], [166.68, 167.84, " захватывающую"], [167.84, 168.66, " стратегическую"], [168.66, 169.0, " нру."], [169.14, 169.24, " Мы"]]}, {"start": 169.24, "end": 174.96, "text": "говорим о миллионе как о выходе из инвестиционной песочницы. Седьмая причина накопить миллион", "words": [[169.24, 169.52, " говорим"], [169.52, 169.6, " о"], [169.6, 169.98, " миллионе"], [169.98, 170.26, " как"], [170.26, 170.6, " о"], [170.6, 171.52, " выходе"], [171.52, 171.64, " из"], [171.64, 172.32, " инвестиционной"], [172.32, 173.02, " песочницы."], [173.28, 173.6, " Седьмая"], [173.6, 174.12, " причина"], [174.12, 174.64, " накопить"], [174.64, 174.96, " миллион"]]}, {"start": 174.96, "end": 179.52, "text": "заключается в том, что с этой суммой у вас появляется доступ к, в кавычках,", "words": [[174.96, 175.42, " заключается"], [175.42, 175.52, " в"], [175.52, 175.68, " том,"], [176.1, 176.14, " что"], [176.14, 176.34, " с"], [176.34, 176.48, " этой"], [176.48, 176.8, " суммой"], [176.8, 176.86, " у"], [176.86, 177.06, " вас"], [177.06, 177.54, " появляется"], [177.54, 178.0, " доступ"], [178.0, 178.74, " к,"], [178.74, 179.12, " в"], [179.12, 179.52, " кавычках,"]]}, {"start": 179.8, "end": 184.56, "text": "интересным игрушкам. Пока у вас на счету меньше миллиона, ваш инвентарь крайне ограничен. Вы", "words": [[179.8, 180.22, " интересным"], [180.22, 180.72, " игрушкам."], [180.86, 181.08, " Пока"], [181.08, 181.18, " у"], [181.18, 181.42, " вас"], [181.42, 181.52, " на"], [181.52, 181.74, " счету"], [181.74, 182.0, " меньше"], [182.0, 182.4, " миллиона,"], [182.42, 182.6, " ваш"], [182.6, 183.34, " инвентарь"], [183.34, 183.66, " крайне"], [183.66, 184.28, " ограничен."], [184.4, 184.56, " Вы"]]}, {"start": 184.56, "end": 193.3, "text": "заперты в рамках самых простых и, честно говоря, не самых доходных инструментах. Обычные", "words": [[184.56, 185.4, " заперты"], [185.4, 185.66, " в"], [185.66, 185.98, " рамках"], [185.98, 186.3, " самых"], [186.3, 186.76, " простых"], [186.76, 186.96, " и,"], [186.96, 187.22, " честно"], [187.22, 187.5, " говоря,"], [187.7, 187.82, " не"], [187.82, 188.04, " самых"], [188.04, 188.46, " доходных"], [188.46, 189.26, " инструментах."], [192.74, 193.3, " Обычные"]]}, {"start": 194.08, "end": 200.26, "text": "новичок, где вы не влияете на результат радикально. Миллион меняет ваш статус в этой игре. Вам", "words": [[194.08, 194.76, " новичок,"], [194.82, 195.0, " где"], [195.0, 195.36, " вы"], [195.36, 195.7, " не"], [195.7, 196.14, " влияете"], [196.14, 196.3, " на"], [196.3, 196.64, " результат"], [196.64, 197.26, " радикально."], [197.56, 198.08, " Миллион"], [198.08, 198.9, " меняет"], [198.9, 199.1, " ваш"], [199.1, 199.38, " статус"], [199.38, 199.52, " в"], [199.52, 199.64, " этой"], [199.64, 200.0, " игре."], [200.12, 200.26, " Вам"]]}, {"start": 200.26, "end": 205.24, "text": "становятся доступны инструменты, которые могут кратно увеличить доходность. Условная бумажная", "words": [[200.26, 200.64, " становятся"], [200.64, 201.06, " доступны"], [201.06, 201.7, " инструменты,"], [201.84, 202.02, " которые"], [202.02, 202.44, " могут"], [202.44, 202.86, " кратно"], [202.86, 203.28, " увеличить"], [203.28, 203.84, " доходность."], [204.2, 204.76, " Условная"], [204.76, 205.24, " бумажная"]]}, {"start": 205.24, "end": 210.52, "text": "недвижимость, недвижимость с плечами. Миллиона конечно не хватит для квартир бизнес-класса,", "words": [[205.24, 205.9, " недвижимость,"], [206.04, 206.46, " недвижимость"], [206.46, 206.64, " с"], [206.64, 207.36, " плечами."], [207.52, 207.9, " Миллиона"], [207.9, 208.42, " конечно"], [208.42, 208.62, " не"], [208.62, 208.96, " хватит"], [208.96, 209.28, " для"], [209.28, 209.66, " квартир"], [209.66, 209.98, " бизнес"], [209.98, 210.52, "-класса,"]]}, {"start": 210.54, "end": 216.12, "text": "даже с апатичным плечом или для помещения под пятерочку. Но условные гаражи или уже ставшие", "words": [[210.54, 210.74, " даже"], [210.74, 210.84, " с"], [210.84, 211.3, " апатичным"], [211.3, 211.88, " плечом"], [211.88, 212.14, " или"], [212.14, 212.76, " для"], [212.76, 213.3, " помещения"], [213.3, 213.48, " под"], [213.48, 214.04, " пятерочку."], [214.16, 214.34, " Но"], [214.34, 214.72, " условные"], [214.72, 215.2, " гаражи"], [215.2, 215.54, " или"], [215.54, 215.8, " уже"], [215.8, 216.12, " ставшие"]]}, {"start": 216.12, "end": 219.78, "text": "мемом кладовки будут вам доступны. Тут наверное надо уточнить, что это вообще не", "words": [[216.12, 216.46, " мемом"], [216.46, 217.02, " кладовки"], [217.02, 217.26, " будут"], [217.26, 217.44, " вам"], [217.44, 217.9, " доступны."], [218.02, 218.24, " Тут"], [218.24, 218.48, " наверное"], [218.48, 218.66, " надо"], [218.66, 219.06, " уточнить,"], [219.16, 219.22, " что"], [219.22, 219.4, " это"], [219.4, 219.68, " вообще"], [219.68, 219.78, " не"]]}, {"start": 219.78, "end": 224.08, "text": "инвестиционная рекомендация. Вам вовсе не обязательно заходить в инструменты с доходностью", "words": [[219.78, 220.34, " инвестиционная"], [220.34, 221.0, " рекомендация."], [221.58, 221.58, " Вам"], [221.58, 221.98, " вовсе"], [221.98, 222.1, " не"], [222.1, 222.48, " обязательно"], [222.48, 222.9, " заходить"], [222.9, 223.02, " в"], [223.02, 223.52, " инструменты"], [223.52, 223.58, " с"], [223.58, 224.08, " доходностью"]]}, {"start": 224.08, "end": 229.7, "text": "под 30%, ибо высокая доходность это всегда повышение риска. Исключений здесь не бывает. Я говорю", "words": [[224.08, 224.3, " под"], [224.3, 225.1, " 30%,"], [225.1, 225.54, " ибо"], [225.54, 225.9, " высокая"], [225.9, 226.5, " доходность"], [226.5, 226.82, " это"], [226.82, 227.14, " всегда"], [227.14, 227.6, " повышение"], [227.6, 227.98, " риска."], [228.04, 228.5, " Исключений"], [228.5, 228.74, " здесь"], [228.74, 228.9, " не"], [228.9, 229.2, " бывает."], [229.4, 229.5, " Я"], [229.5, 229.7, " говорю"]]}, {"start": 229.7, "end": 235.94, "text": "лишь о том, что такие инструменты становятся вам доступны. Не более. И раз уж вы досмотрели до", "words": [[229.7, 229.92, " лишь"], [229.92, 230.04, " о"], [230.04, 230.2, " том,"], [230.34, 230.56, " что"], [230.56, 230.76, " такие"], [230.76, 231.5, " инструменты"], [231.5, 231.9, " становятся"], [231.9, 232.1, " вам"], [232.1, 232.8, " доступны."], [232.88, 233.1, " Не"], [233.1, 233.34, " более."], [234.34, 234.58, " И"], [234.58, 234.78, " раз"], [234.78, 234.96, " уж"], [234.96, 235.08, " вы"], [235.08, 235.72, " досмотрели"], [235.72, 235.94, " до"]]}, {"start": 235.94, "end": 241.94, "text": "этого момента, для вас восьмая бонусная причина. Миллион — это фильтр ваших отношений с", "words": [[235.94, 236.12, " этого"], [236.12, 236.84, " момента,"], [236.86, 237.04, " для"], [237.04, 237.68, " вас"], [237.68, 238.38, " восьмая"], [238.38, 238.92, " бонусная"], [238.92, 239.52, " причина."], [239.64, 240.16, " Миллион"], [240.16, 240.36, " —"], [240.36, 240.54, " это"], [240.54, 241.06, " фильтр"], [241.06, 241.44, " ваших"], [241.44, 241.8, " отношений"], [241.8, 241.94, " с"]]}, {"start": 241.94, "end": 246.34, "text": "окружающими людьми. Я без понятия как это происходит, но с ростом капитала органически", "words": [[241.94, 242.54, " окружающими"], [242.54, 242.86, " людьми."], [243.0, 243.16, " Я"], [243.16, 243.34, " без"], [243.34, 243.66, " понятия"], [243.66, 243.78, " как"], [243.78, 243.98, " это"], [243.98, 244.38, " происходит,"], [244.52, 244.78, " но"], [244.78, 244.88, " с"], [244.88, 245.18, " ростом"], [245.18, 245.7, " капитала"], [245.7, 246.34, " органически"]]}, {"start": 246.34, "end": 251.14, "text": "меняется и окружение. Тут я не буду долго рассказывать про то, почему окружение с", "words": [[246.34, 246.8, " меняется"], [246.8, 247.0, " и"], [247.0, 247.66, " окружение."], [248.26, 248.4, " Тут"], [248.4, 248.58, " я"], [248.58, 248.72, " не"], [248.72, 248.9, " буду"], [248.9, 249.08, " долго"], [249.08, 249.68, " рассказывать"], [249.68, 249.82, " про"], [249.82, 249.98, " то,"], [250.24, 250.48, " почему"], [250.48, 251.04, " окружение"], [251.04, 251.14, " с"]]}, {"st