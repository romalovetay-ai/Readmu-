cosmetology/biorev/cache/

# publish packages: keep texts and thumbnails, skip the heavy video files
publish/*/*.mp4
kits/herk-edit-kit/node_modules/

# research: raw thumbnails and frames are re-downloadable; keep contact sheets and data
research/*/thumbs/
research/*/frames/
research/*/tg.html
research/*/err.txt

