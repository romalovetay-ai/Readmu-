node_modules/
__pycache__/
# animate pieces: keep sources and the shareable render, skip the heavy intermediates
pieces/*/frames*/
pieces/*/review*/
pieces/*/renders/*
!pieces/*/renders/share.mp4
!pieces/*/renders/topa-shorts.mp4

# cosmetology reels: skin textures, TTS and render intermediates are regenerated by build.py
cosmetology/src/cache/
cosmetology/biorev/cache/

# publish packages: keep texts and thumbnails, skip the heavy video files
publish/*/*.mp4
kits/herk-edit-kit/node_modules/

# research: raw thumbnails and frames are re-downloadable; keep contact sheets and data
research/*/thumbs/
research/*/frames/
research/*/tg.html
research/*/err.txt

# kvartira video: TTS cache and render intermediates are regenerated by build.py
videos/kvartira/cache/
videos/kvartira/out/*
!videos/kvartira/out/thumb.jpg
# third-party source video sent for analysis: not redistributed
research/kvartira_src/*.mov
research/kvartira_src/*.wav
research/kvartira_src/part*.json
research/kvartira_src/transcribe.log
