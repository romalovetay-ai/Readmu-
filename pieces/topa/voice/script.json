{
 "lead": 1.5,
 "tail": 7.0,
 "lines": [
  {
   "id": "l1",
   "text": "На солнечной полянке жил-был медвежонок Топа.",
   "file": "l1.mp3",
   "after": 1.4
  },
  {
   "id": "l2",
   "text": "У Топы был красный воздушный шарик!",
   "file": "l2.mp3",
   "after": 1.6
  },
  {
   "id": "l3",
   "text": "Но вдруг подул ветер, и шарик улетел!",
   "file": "l3.mp3",
   "after": 2.0
  },
  {
   "id": "l4",
   "text": "Шарик застрял высоко-высоко на дереве.",
   "file": "l4.mp3",
   "after": 0.6
  },
  {
   "id": "l5",
   "text": "Топа заплакал.",
   "file": "l5.mp3",
   "after": 1.6
  },
  {
   "id": "l6",
   "text": "Прискакал зайчик: я допрыгну!",
   "file": "l6.mp3",
   "after": 0.4
  },
  {
   "id": "l7",
   "text": "Прыг! Скок! Прыг! Не достал.",
   "file": "l7.mp3",
   "after": 1.4
  },
  {
   "id": "l8",
   "text": "Прибежал ёжик: давай построим горку из пеньков!",
   "file": "l8.mp3",
   "after": 2.2
  },
  {
   "id": "l9",
   "text": "Топа полез наверх. Почти! Нет, высоко.",
   "file": "l9.mp3",
   "after": 1.6
  },
  {
   "id": "l10",
   "text": "Тогда прилетела птичка.",
   "file": "l10.mp3",
   "after": 0.5
  },
  {
   "id": "l11",
   "text": "Она взяла ниточку клювом,",
   "file": "l11.mp3",
   "after": 2.4
  },
  {
   "id": "l12",
   "text": "и опустила шарик прямо в лапы Топе!",
   "file": "l12.mp3",
   "after": 2.2
  },
  {
   "id": "l13",
   "text": "Ура! Вместе у друзей всё получается!",
   "file": "l13.mp3"
  }
 ]
}